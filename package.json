{
  "name": "improv-jam",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "extract": "python3 scripts/extract_catalog.py",
    "catalog:snapshot": "mkdir -p scripts/data && curl -fsSL https://improv-jam.vercel.app/api/catalog -o scripts/data/catalog-snapshot.json",
    "learnimprov": "python3 scripts/learnimprov/fetch.py && python3 scripts/learnimprov/normalize.py && python3 scripts/learnimprov/match.py",
    "learnimprov:merge": "python3 scripts/learnimprov/merge_review.py",
    "clasp:login": "npx --yes @google/clasp@3.1.3 login",
    "clasp:push": "npm run extract && npx --yes @google/clasp@3.1.3 push --force --project apps-script"
  },
  "dependencies": {
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.544.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^1.0.3"
  }
}
