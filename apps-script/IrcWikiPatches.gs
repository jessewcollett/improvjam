var IRC_WIKI_SOURCE = {"id": "src-irc-wiki", "name": "IRC Improv Wiki", "url": "https://wiki.improvresourcecenter.com/", "note": "GFDL 1.2 / CC BY-SA 3.0. Rehearsal cards are adapted from https://wiki.improvresourcecenter.com/ with attribution."};
var IRC_WIKI_PATCHES = [{"tab": "Games", "id": "irc-a-to-c", "category": "Long Form|Opening", "tags": "Opening", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=A_to_C", "create": true, "replacePlaceholder": true, "name": "A to C", "description": "Association opening. Start at the suggestion, then jump ideas that are only loosely related until the room is somewhere new. Use those distant ideas to start the set.", "howToPlay": "• The suggestion \"Range Rover\" is taken. An A to C could look like Range Rover --> Safari --> Africa • A Idea: A scene sitting in a Range Rover, driving down a highway. • B Idea: A scene during a safari exploration. • C Idea: A group of musicians recording a tribute song for impoverished children in Africa.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-a-to-c-exercise", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=A_to_C_(exercise)", "create": true, "replacePlaceholder": true, "name": "A to C (exercise)", "category": "Warm-Up", "tags": "Warm-Up", "description": "Circle association. One player says a word; the next says something related to that, not the original. Keep moving away from the start.", "howToPlay": "• \"French\" (A) • \"Eggs\" (C) • \"Fries\" (B) and new (A) • \"Behind\" (C) • \"Ketchup\" (B) and new (A)", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-answering-machine", "category": "Warm-Up|Opening", "tags": "Opening|Warm-Up", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Answering_Machine", "create": true, "replacePlaceholder": true, "name": "Answering Machine", "description": "Opening. Players leave overlapping answering-machine messages inspired by the suggestion, then tap those messages for scenes.", "howToPlay": "• Players form a semicircle. • Players take on the roles of individuals leaving messages for someone who never checks their voicemail. • Each player selects a character, such as a spouse, a boss, a UPS driver, a doctor, or any person that would realistically or unrealistically call the voicemail owner. • Characters should each have a unique relationship to the person they’re calling and distinct motivations for leaving their messages. • One stepping forward at a time to leave their message. Each message is short, typically one or two sentences, and should reveal a detail about the caller’s life, their relationship to the voicemail owner, or the larger story. For example, a UPS driver might be frustrated about repeated failed delivery attempts wastning their time, while a boss might demand answers about an unreasonable project deadline. • Each player's new message can build on what others have established. Messages can refer back to previous ones, revealing how the characters’ lives intersect or how their concerns might tie together. For example, the doctor’s message could address something mentioned by the spouse or the drug dealer might reference an event hinted at by the boss. • The voicemail owner is never shown or heard, so their personality and actions are inferred solely through the content of the messages. • The game concludes when each player has left two or three…", "gimmicks": "Answering Machine is a storytelling and character dynamics game. The goal is for players to create a vivid picture of a person’s life without ever portraying them directly. By layering the messages left by different characters, the group builds character choices, relationships, and connections between seemingly unrelated details. It also could work as an Opening", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-apocalypse", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Apocalypse", "create": true, "replacePlaceholder": true, "name": "Apocalypse", "category": "Long Form", "tags": "", "description": "Two-half long form: an Eventé that ends the world, then a monoscene in the aftermath.", "howToPlay": "A single suggestion is taken. The form consists of two halves. The first half is an Eventé, the opening scene of which culminates in the end of the world (meteor striking the Earth, aliens invading, zombies over running everyone, etc). The second half is a Monoscene that takes place some time after the events of the first half, perhaps a post apocalypse or dystopian world.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-monologue-deconstruction", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Monologue_Deconstruction", "create": true, "replacePlaceholder": true, "name": "Monologue Deconstruction", "category": "Long Form", "tags": "", "description": "One or more monologues, then scenes that pull apart the ideas inside them.", "howToPlay": "• The Armando Diaz Experience, Theatrical Movement and Hootenanny • ASSSSCAT 3000 • The Alvy", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-ba-da-da", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Ba_Da_Da", "create": true, "replacePlaceholder": true, "name": "Ba Da Da", "category": "Warm-Up", "tags": "Warm-Up", "description": "Players in a circle. Everyone claps or slaps their thighs in rhythm. Player one says a word or short phrase to the player next to him/her. That player responds with whatever word/phrase he/she thinks of. The entire circle then says the first word, the second word and then says \"Ba Da Da.\" The second player then repeats the process by saying a word/phrase to the third player. \"House\" \"Boat\" Whole circle: \"House boat ba da da.\"", "howToPlay": "\"House\" \"Boat\" Whole circle: \"House boat ba da da.\" \"Mutual\" \"Affection\" Whole circle: \"Mutual Affection ba da da\" It's similar to a segment on the 1970s kids show The Electric Company where two silhouted heads faced each other -- the first would say the first half a word, the second the second and then they'd both say the whole word together.", "gimmicks": "Making simple choices in reaction to someone else's choice. To make specific choices. It also embodies \"Don't Think.\" The idea is to respond quickly and maintain the rhythm, and not \"think\" about whether your response makes sense, or is the best possible one.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-bad-rap", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Bad_Rap", "create": true, "replacePlaceholder": true, "name": "Bad Rap", "category": "Warm-Up", "tags": "Warm-Up", "description": "Bad Rap is a verbal warm up. It is also know as \"Boom Shaka Laka.\" It is in certain ways the opposite of \"Beastie Boys Rap.\"", "howToPlay": "• A rhyming syllable is established by the first player. The second player then raps a sentence whose final word would obviously rhyme with that that syllable, but does not fill in the final rhyming word. The third player must fill it in with a word that does not rhyme. The third player then sets a up sentence to rhyme with their new word, and the fourth fills in with a new non-rhyming word. • To hear the rhythm of this exercise, see here - hover your cursor over the text \"All\" at the top left of the page to find a play button. • All: \"Bad rap, bad rap, bad rap\" • A: \"I went to the store to buy a shirt.\" • All: \"Bad rap, bad rap, bad rap\" • B: \"I got punched in the arm and it really...\" • C: \"...stunk!\" • All: \"Bad rap, bad rap, bad rap\" • C: \"I live in a monastery, I'm a...\" • D: \"...priest!\" • All: \"Bad rap, bad rap, bad rap\" • D: \"Come one, come all, for the Thanksgiving...\" • E: \"...food!\" • Etc.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "ie-the-bat", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Bat"}, {"tab": "Games", "id": "irc-beast-bass-bird", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Beast_bass_bird", "create": true, "replacePlaceholder": true, "name": "Beast bass bird", "category": "Warm-Up", "tags": "Warm-Up", "description": "Beast Bass Bird is a physical warmup created by the team Jump Stitch at Bexar Stage on October 29, 2019. Players stand in a circle. Player 1 jumps into the middle, makes eye contact with another player (Player 2), and they simultaneously clap once while each saying either \"Beast\", \"Bass\" (like the fish), or \"Bird\". If they both say the same word of those three, then they change places, and Player 2 goes to the middle, turns to another player, and they repeat the clap while saying either \"Beast\", \"Bass\", or \"Bird\". If the two players don't match words, the player in the middle turns to another player and tries again. The player in the middle keeps going until they match with another player…", "howToPlay": "• Player 1 jumps into the center of the circle and makes eye contact with another player (Player 2) • Player 1 claps and says \"Beast\" at the same time Player 2 claps and says \"Bird\" • No match, so Player 1 turns to another player (Player 3) and makes eye contact • Player 1 claps and says \"Bird\" at the same time Player 3 says \"Bird\" • That's a match, so Player 1 and Player 3 swap places • Player 3, now in the middle, turns to another player (Player 4) and makes eye contact • Player 3 claps and says \"Bass\" at the same time Player 4 claps and says \"Beast\" • No match, so Player 3 turns to another player (Player 5) and makes eye contact • Player 3 claps and says \"Beast\" at the same time Player 5 claps and says \"Bird\" • No match, so Player 3 turns to Player 2 and makes eye contact • And so on...", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-beastie-boys-rap", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Beastie_Boys_Rap", "create": true, "replacePlaceholder": true, "name": "Beastie Boys Rap", "category": "Warm-Up", "tags": "Warm-Up", "description": "Beastie Boys Rap is a verbal warm up.", "howToPlay": "• To hear an example of the rhythm of this exercise, see here (hover your cursor above the \"Player A\" text and click the play button). • This warm-up begins with the players standing in a circle. Player A starts by rapping a very simple line. It follows the unstress-stress pattern of any line from \"Fight For Your Right To Party.\" For example: • Player A: LIVing at HOME is SUCH a DRAG. • Everyone responds with the Beastie Rap that follows the same pattern. Below is a simple version of this pattern (you may replace the consonants or make more complex variation, depending on your skill level with rapping): • Everyone: YAH buh-buh-BAH buh-BAH buh-BAH BAH! • Continuing on through the circle to Player A's right, each player comes up with a simple line that fits the rhythm and rhymes with Player A's original line. In between each line, the Beastie Rap is repeated. • Player B: I had to wash dishes so I used a dish rag. • Everyone: YAH buh-buh-BAH buh-BAH buh-BAH BAH! • Player C: Car And Driver Magazine is my favorite auto mag. • Everyone: YAH buh-buh-BAH buh-BAH buh-BAH BAH! • Player D: I went to the prom alone, I went stag! • Everyone: YAH buh-buh-BAH buh-BAH buh-BAH BAH! • The rap continues around the circle until it reaches A again. After A has gone twice, Player B begins a totally new rap with a totally new word to rhyme with. This keeps going until everyone has had a chance to…", "variations": "Beastie Boys Rap can also be done so that each line continues off of the previous line to tell a single, coherent story. A related warm-up is Bad Rap, in which players intentionally avoid rhyming. Some people prefer to sing DOOBIE DOOBIE DOOBIE, DOOBIE DOOBIE DOO in between rhymes. These people are wrong.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "ie-big-booty", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Big_Booty"}, {"tab": "Games", "id": "irc-big-ole-sentence", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Big_Ole_Sentence", "create": true, "replacePlaceholder": true, "name": "Big Ole Sentence", "category": "Warm-Up", "tags": "Warm-Up", "description": "This is a warmup meant to work on concentration and memory. The structure is simple. The first person comes up with a simple and short sentence. Each next person repeats the sentence, adding another detail. Previously added details can be neither dropped nor changed. The game goes until the sentence gets too long for people to repeat.", "howToPlay": "The structure is simple. The first person comes up with a simple and short sentence. Each next person repeats the sentence, adding another detail. Previously added details can be neither dropped nor changed. The game goes until the sentence gets too long for people to repeat. The progression could go something like this: \"There is a car.\"", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-biography", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Biography", "create": true, "replacePlaceholder": true, "name": "Biography", "category": "Warm-Up", "tags": "Warm-Up", "description": "Biography is a warmup created by Adam Pally and Gil Ozeri. One person makes up a name, and someone else must state facts about that person as quickly as possible, without stopping. However, no fact can clearly relate to another. If they do, another person can call bull shit, and a new name and biography are invented.", "howToPlay": "• A: \"Your name is Jeremiah Windsprint\" • B: \"I have a pet frog\" • B: \"I served as a flying ace in World War II\" • B: \"My hair is very curly\" • B: \"I have a patch over my left eye\" • B: \"I flew the Spruce Goose\" • A: \"Bullshit! You already mentioned being a pilot.\"", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-burrito", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Burrito", "create": true, "replacePlaceholder": true, "name": "Burrito", "category": "Long Form", "tags": "", "description": "The \"Burrito\" is a music improv form, in which 4 singers layer lyric material on a repeating musical vamp. The format of the Burrito, as used by such groups as Major 7th, Melodious Din, and iMusical: The Improvised Musical, is as follows:", "howToPlay": "The format of the Burrito, as used by such groups as Major 7th, Melodious Din, and iMusical: The Improvised Musical, is as follows: Four singers stand in a horizontal line on stage. A suggestion is received, after which the pianist establishes a repeating musical vamp. After the musical vamp is established, Singer A improvises a couplet. Singer A repeats that couplet. This informs the other singers, and the pianist, as to the length of each couplet, which should remain consistent for the duration of all future couplets in the Burrito. Singer B improvises a different couplet. Singer B repeats that couplet, while Singer A simultaneously sings her original couplet. Singers A & B repeat their couplets, while Singer C simultaneously improvises a third, unique couplet. Singers A, B & C repeat their couplets, while Singer D simultaneously improvises a fourth, unique couplet. All four singers simultaneously repeat their couplets. All four singers drop their volume, while continuing to simultaneously repeat their couplets. At this time, the singers alternate taking solos while the others are repeating their own couplets. These solos should be completely new lyric material, with the…", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-butt-tag", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Butt_Tag", "create": true, "replacePlaceholder": true, "name": "Butt Tag", "category": "Warm-Up", "tags": "Warm-Up", "description": "Butt Tag is just like normal tag, except whoever is it has to tag people with their butt. You play until someone is almost injured, or you have caused damage to your surroundings. It's an energy warm up. It was developed by Moxie and has been the cause of a few holes in the walls at the Magnet Theater.", "howToPlay": "Butt Tag is just like normal tag, except whoever is it has to tag people with their butt. You play until someone is almost injured, or you have caused damage to your surroundings. It's an energy warm up. It was developed by Moxie and has been the cause of a few holes in the walls at the Magnet Theater.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-caligula-exercise", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Caligula_Exercise", "create": true, "replacePlaceholder": true, "name": "Caligula Exercise", "category": "Warm-Up", "tags": "Warm-Up", "description": "A character exercise in which three people walk around the room in neutral spine and are then given a physical characteristic. They are then told to give those characters names and voices. This is done three times. Then each participant picks their favorite (or most challenging) character and sits down in three chairs. They are then interviewed as those characters on who they are and how they all know each other.", "howToPlay": "A character exercise in which three people walk around the room in neutral spine and are then given a physical characteristic. They are then told to give those characters names and voices. This is done three times. Then each participant picks their favorite (or most challenging) character and sits down in three chairs. They are then interviewed as those characters on who they are and how they all know each other.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-call-the-corpse", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Call_The_Corpse", "create": true, "replacePlaceholder": true, "name": "Call The Corpse", "category": "Long Form", "tags": "", "description": "Premiered on 16 February 2012 in Bremen, Germany by die beiden (2 person show).", "howToPlay": "• The show starts with one actor on stage playing a dead body. The other actor enters the stage, acknowledges the dead body and starts painting the room together with the audience. After a few minutes the telephone rings and someone calls. The answering machine picks up. The actor who has just painted the room goes offstage and starts to speak on the answering machine. The actor who has played the corpse takes over the phone call midsentence and continues to play the caller. Now a scene starts that can last from 2 to 15 minutes and can either be a simple 2-person scene, a short monoscene or a macroscene. The whole show is 'true to time'. • After that scene is done, we go back to the room. Now the actor who used to be the dead body at the beginning continues painting the room. Then another caller and another scene (2-person, mono or macro). Everytime we revisit the room the 'room painter' should go into details based on previous room descriptions. It is also good to include traces of human life. These descriptions offer inspiration for subsequent scenes. • It seems important to us to give the feeling of coherence and not let a call and the subsequent scene be totally random. The description of the room informs the character of the dead person in the room. The character of the dead person determines possible characters that would call this person as well as reasons for their…", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-caravan", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Caravan", "create": true, "replacePlaceholder": true, "name": "Caravan", "category": "Long Form", "tags": "", "description": "==The Caravan==\n\nThe Caravan is a form created in 2024 by Michael Greene. It was created to introduce openings, premise, pattern based play, group games, and ensemble ownership of every aspect of the show to students in preparation for the Harold. Structurally, the Caravan is simply any opening followed by a series of scenes. The only *strict* creative constraint is that \"tag-outs\" are not allowed in the form.", "howToPlay": "• The Caravan is a form created in 2024 by Michael Greene. It was created to introduce openings, premise, pattern based play, group games, and ensemble ownership of every aspect of the show to students in preparation for the Harold. • Structurally, the Caravan is simply any opening followed by a series of scenes. The only *strict* creative constraint is that \"tag-outs\" are not allowed in the form. • Thematically, the Caravan aims to display a large variety of scene types and stage pictures. • When teaching the Caravan as a class, improvisers are exposed to traditional group game \"templates\" such as: • Hey everybody, get in here • Help Desk • Pile On • Peel Off • Sound and Movement • Improvisers are however encouraged to initiate scenes with no particular structure in mind, and instead observe the following guiding principles: • the number of people in a scene is not necessarily the same as the number of points of view. (3 person scenes are often 2 pov's) • a scene only requires that the entire ensemble invests in what has already happened • the entire ensemble has ownership of every character and every comedic idea • Because \"tag-outs\" are prohibited, \"walk-ons\" become an essential tool for the ensemble. • \"Walk-ons\": • Require the ensemble to manage sharing focus without the concrete edit that \"tag-outs\" offer • good \"walk-ons\" have \"walk-offs\" • \"walk-ons\" can be used to…", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-categories", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Categories", "create": true, "replacePlaceholder": true, "name": "Categories", "category": "Warm-Up", "tags": "Warm-Up", "description": "Circle. A category is called (breakfast cereals, cities). Players fire examples without repeating or breaking rhythm.", "howToPlay": "• Players stand in a circle, often making \"drumroll\" noises by slapping their hands on their thighs. The first player will shout a category, for example, \"Breakfast Cereal,\" and each player in turn will name an item in that category - Cheerios, Oatmeal, etc. When it gets to the original namer of the category, they shout out an item in the category, and the next person names a new category until everyone in the circle has had a turn picking a category. • It is most important to keep the circle moving and not stall. While it is preferable to keep thinking in the category pattern, it is okay to shout out a \"wrong\" answer (ie, Bananas to the above category), and keep the rhythm going around the circle. • This is a fun moderate-energy warmup.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-character-circle", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Character_Circle", "create": true, "replacePlaceholder": true, "name": "Character Circle", "category": "Warm-Up", "tags": "Warm-Up", "description": "Character Circle is a character matching warmup. All players stand in a circle. One person then steps into the middle and looks at one of the people in the circle. That person must start delivering a line of dialogue as a character. The person in the middle then will mimic that character, finishing the line. The person in the middle then looks to the next person in the circle, and play continues until every person around the circle has started a character. Then the person in the middle returns to the circle and a new person steps in.", "howToPlay": "All players stand in a circle. One person then steps into the middle and looks at one of the people in the circle. That person must start delivering a line of dialogue as a character. The person in the middle then will mimic that character, finishing the line. The person in the middle then looks to the next person in the circle, and play continues until every person around the circle has started a character. Then the person in the middle returns to the circle and a new person steps in.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-chimichanga", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Chimichanga", "create": true, "replacePlaceholder": true, "name": "Chimichanga", "category": "Long Form", "tags": "", "description": "The \"Chimichanga\" is a music improv form developed by Travis Ploeger, and used in his show, iMusical: The Improvised Musical. It currently serves as the opening form for the show. After receiving the suggestion, a scene begins, underscored with music by the pianist. After a short but satisfying amount of time, this scene is sweep edited into another scene, with completely different improvisers playing completely different characters, still underscored. After another short but satisfying amount of time, this scene is sweep edited into a third scene, with completely different improvisers playing completely different characters, still underscored. After another short but satisfying amount of…", "howToPlay": "After receiving the suggestion, a scene begins, underscored with music by the pianist. After a short but satisfying amount of time, this scene is sweep edited into another scene, with completely different improvisers playing completely different characters, still underscored. After another short but satisfying amount of time, this scene is sweep edited into a third scene, with completely different improvisers playing completely different characters, still underscored. After another short but satisfying amount of time, this scene is sweep edited, and Character A, from one of the first two scenes, initiates a verse/chorus song. She sings one verse and one chorus. Character B, from a different scene from Character A, joins Character A on stage, but in a split screen. He sings a second verse, and both characters sing the chorus together. Character C, from any previous scene, joins the others on stage, again in a split screen. She sings a bridge. Character D, from any previous scene, joins the others on stage, again in a split screen. He sings the fourth verse. All other characters (if any have yet to enter), join with their respective scene partners, and the entire company sings the…", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-clap-in", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Clap-In", "create": true, "replacePlaceholder": true, "name": "Clap-In", "category": "Long Form", "tags": "", "description": "The \"clap in\" form is one of the signature forms of Empty Stage Comedy: A group of players stands on the back wall of the stage while a scene is playing At an appropriate point a player will clap their hands loudly The plays already on stage will freeze The player that clapped will join the stage, doing the following: Bring in others they want to join scene Tagout those that they want to leave the stage", "howToPlay": "A group of players stands on the back wall of the stage while a scene is playing At an appropriate point a player will clap their hands loudly The plays already on stage will freeze The player that clapped will join the stage, doing the following: Bring in others they want to join scene Tagout those that they want to leave the stage", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-code-blue-improv-taboo", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Code_Blue:_Improv_Taboo", "create": true, "replacePlaceholder": true, "name": "Code Blue: Improv Taboo", "category": "Long Form", "tags": "", "description": "Code Blue: Improv Taboo is a long-format that addresses transgressive topics, utilizing character monologues, premise based scenes, mapping games, and meta-narrative. In this fully improvised, late-night format, advanced players tickle the under-belly of political correctness, crossing lines few comedians dare to cross. Inspired by audience suggestions of the most cringe worthy subjects, Code Blue runs the gamut of improv taboo. No topic, no action, no word is safe in this hour long decent into madness created by Tavish Forsyth at the Baltimore Improv Group.", "howToPlay": "• Tavish Forsyth, Julia Gerhardt, Patrick Hampton, Hannah Jeffrey, Jacob Joseph, Brian Leonard, Kristen McKenzie, Kim Scarfe, and Jeff Toppe. • Tavish Forsyth created the format and directed the first show at the Baltimore Improv Group in 2018. Tavish was inspired by the Town Council and Spokane formats, as well as play styles taught by Jimmy Carrane, Liz Allen, Keisha Zollar, Elana Fishbein, and Upright Citizens Brigade. • As a Code Blue Agent, every improviser chooses a provocative codename. • Pre-show, the audience will submit taboo topics on 8.5”x11” paper. Each topic will be placed in a manila folder. • The format is analogous to the Spokane and Town Council formats. Over the course of an hour the improvisers, or “agents,” will do scenes, or “missions,” based on the taboo topics. After each “mission,” the agents will return to the “briefing room,” the central scene. • When beginning a new mission, one agent will read the topic aloud and decide how that topic or “mission” will be handled. • Option 1 – Going Undercover: An agent reads a topic out loud or silently. If silently, the agent will label the mission “top-secret” and initiate a scene or character monologue that directly addresses the taboo topic in the first line. Conversely, if the topic is read aloud, and the team decides to go undercover, any agent can initiate with a character that directly addresses the topic…", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-count-to-20", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Count_to_20", "create": true, "replacePlaceholder": true, "name": "Count to 20", "category": "Warm-Up", "tags": "Warm-Up", "description": "Group counts to 20. Anyone may say the next number; if two people speak at once, start over.", "howToPlay": "Players form a tight circle and place their arms around the shoulders or waists of the people next to them. Everyone shuts his/her eyes. Someone says \"one,\" someone else says \"two.\" If two people say a number at the same time, the group starts over at one.", "gimmicks": "To calm a group down before a show. To practice patience. To find a mysterious natural pace of the group mind.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-crazy-eights", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Crazy_Eights", "create": true, "replacePlaceholder": true, "name": "Crazy Eights", "category": "Warm-Up", "tags": "Warm-Up", "description": "Crazy Eights is a high-energy warm up exercise. Players form a circle. In unison, everyone lifts their right hand, shakes it quickly, and counts to 8. They repeat this with their left hand, then their right foot (kicking it in the air while balancing on the left) and finally with their left foot. Everyone immediately repeats the pattern, except this time the players only count up to 7. In each round, the players count up to one less number, until everyone is quickly waving their entire body shouting \"1! 1! 1! 1!\" Then everybody cheers.", "howToPlay": "• Same rules, except players count up in Spanish. • Similar rules, except players count up to 16 on the first round, and then to 8 on the next round, and half it at each round. • Everyone in the group must deliver each set of numbers differently, and must all decide this together instantly and organically. So the first run-through up to 8 could be delivered as, say, a pirate. Then the next run through up to 7 would have to be delivered as something different, for instance as a little girl.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-dear-diary", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Dear_Diary", "create": true, "replacePlaceholder": true, "name": "Dear Diary", "category": "Long Form", "tags": "", "description": "Dear Diary is a longform improv form developed by Kevin Shimko at the Comedy Arts Theater of Charlotte in December 2022. It consists of two distinct sections: first, each member of the team (along with the audience) is shown an audience-supplied image, at which point they improvise a short (45s - 1 minute) diary entry from a character based on the image shown. This is followed by scenework based around those characters.", "howToPlay": "Dear Diary is a longform improv form developed by Kevin Shimko at the Comedy Arts Theater of Charlotte in December 2022. It consists of two distinct sections: first, each member of the team (along with the audience) is shown an audience-supplied image, at which point they improvise a short (45s - 1 minute) diary entry from a character based on the image shown. This is followed by scenework based around those characters.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "jam-deconstruction", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Deconstruction"}, {"tab": "Games", "id": "irc-demand-a-dance", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Demand_a_Dance", "create": true, "replacePlaceholder": true, "name": "Demand a Dance", "category": "Warm-Up", "tags": "Warm-Up", "description": "Players in a circle. One player points at another and names a fictional dance (\"Snappy Penguin,\" \"Grabbing Some Bread,\" \"The Angry Wheelbarrow\"). The player pointed at must create a dance inspired by that name, and the other members of the group copy as it's being done. After a few moments, another player (neither the one who made up that dance or the dancer) will point at someone else and name another ficitonal dance.", "howToPlay": "Players in a circle. One player points at another and names a fictional dance (\"Snappy Penguin,\" \"Grabbing Some Bread,\" \"The Angry Wheelbarrow\"). The player pointed at must create a dance inspired by that name, and the other members of the group copy as it's being done. After a few moments, another player (neither the one who made up that dance or the dancer) will point at someone else and name another ficitonal dance.", "gimmicks": "To be silly. To be instantly inspired by a suggestion. To wake up physically.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-detours", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Detours", "create": true, "replacePlaceholder": true, "name": "Detours", "category": "Long Form", "tags": "", "description": "Detours is a form that examines all the possible ways that a single, short scene could have gone but didn't. The players perform a starting scene, lasting two to five minutes, and then perform variations on the original scene. The form was originally developed by People of Earth in Chicago. It was taught to Theatre Strike Force, an improv group in Gainesville, Florida, in a workshop. Two graduates of this group - Boris Glebov and Desika \"Nopey\" Narayanan - transported it to the Tucson improv scene when they moved there for grad school.", "howToPlay": "• After taking a suggestion, the group performs a medium-length scene, perhaps two to five minutes in length. It is usually a two-person scene which evolves through several beats. Once this original scene wraps up, the group then begins performing the scene again. However, as perfect repetition is impossible, mistakes will happen, and the original scene will change. Detours basically takes advantage of this, exploring mistakes, or even making changes intentionally. • The original scene is usually not repeated in its entirety, but rather each beat is examined and re-done separately, in order. This way, the group slowly makes its way through the original story, varying every possible detail but keeping the overall, general direction. • Usually tag-out and sweep edits are used. Tag-outs are meant to restart the immediate line of dialogue or action (similar to how New Choice is played). Sweep edits reset the action to the beginning of a beat. • The pace of the form's action frequently varies. As the scene progresses, the group will often come upon a detail that has many possible alternatives. A rapid succession of tag-out edits will follow, where many possibilities are offered. • People that played in the original scene are not limited to their original characters. To keep things clear, it helps to assume the physical location where the character one wishes to play is expected to…", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-do-as-i-do", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Do_as_I_Do", "create": true, "replacePlaceholder": true, "name": "Do as I Do", "category": "Warm-Up", "tags": "Warm-Up", "description": "\"Do As I Do\" is an energy warm up.", "howToPlay": "• The beauty of this exercise lies in its utter simplicity. It can be thought of as a building block to Follow the Follower. • Everybody in a circle, the leader somewhere in that circle as well. Not inside it, just standing like any other person. • Say something like \"The title of this exercise is the only thing you need to know. It's called \"Do As I Do.\" • The leader proceeds to perform improvised sound and movement combinations that constantly morph and transform, and the rest of the group mimics them. • The first half of the bullet points indicates the movement and the second indicates the sound. • Bouncing a baby in front of you / cooing to it → • Spinning a pizza into the air / exclaiming like a pizza chef → • Popping bubbles above your head / each with a “pop” sound → • Pantomiming rain falling down / “shhh” rain sounds → • Etc. • This is a favorite exercise of the Story Pirates.", "gimmicks": "Each combination should vary in rhythm, speed, and tone. Try to live in each one of the them for a spell, repeating or exploring it for 5 or 6 seconds, and then move on. Consider sharing leadership in this exercise. You could establish a signal beforehand that transfers the leadership role.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-documentary-opening", "category": "Long Form|Opening", "tags": "Opening", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Documentary_Opening", "create": true, "replacePlaceholder": true, "name": "Documentary Opening", "description": "Interview-style opening: players talk to an unseen camera about the suggestion, then those interviews feed the set.", "howToPlay": "It's important for players to offer numerous of gifts to each other in this opening, avoiding excessive dialogue or plot, as this is just an opening, and not a scene. Details about a situation, actions, or world that the pairs have created can be pulled from the opening, or even potentially strong characters that the audience seems to respond to. It's important to avoid playing game in this opening as it makes it harder for your teammates to try and play out the game further after the opening. I learned this from Billy Merrit he emphasized that each pair's interview should start about one thing, and then evolve into something different. He got this idea from watching documentary films like Sherman's March, where the filmmaker went out to make a movie tracing General William Tecumseh Sherman's march through Georgia and the Carolinas but instead ended up focusing on his love life.", "variations": "There are many variations of the documentary opening. One more common variation is that the pairs do not necessarily come back. Instead of repeating pairs, new pairs come out until the opening is edited.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-e-5-dammit", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=E-5-Dammit", "create": true, "replacePlaceholder": true, "name": "E-5-Dammit", "category": "Warm-Up", "tags": "Warm-Up", "description": "E-5-Dammit is a verbal concentration warmup, named after player 5's likely exclamation. This variation of the popular Big Booty style game was taught to Paperback Rhino by Comedy Xperiment, who perhaps invented it.", "howToPlay": "• Players stand in a circle. One person is 'A'. Players are labeled to the leaders left, such that a 7 person group would have person G standing to A's right. • In the first round of play, A will say the letter of someone else in the group. That person will respond by saying another letter, establishing a rhythm that should be maintained. Play continues until someone messes up. • For example: • A:\"C\" • C:\"F\" • F:\"B\" • B:\"D\" • D:\"Q\" -but this group doesn't have 17 players! • D:\"Dammit!\" • If someone makes a mistake, they must go to A's right. This is the end of the line. Players move to filling the vacant spot, and must assume the appropriate letter for their position (i.e. letters are always in order). • After a short time, ideally well before players become proficient at this version, move on to round two. • In Round Two, numbers are added. They behave exactly like letters, A=1, B=2, C=3, etc. Players now have the option of calling out a letter or a number, and the added challenge of listening for both their own letter and number. • Again, before players have mastered the variation, move on to round three. • In Round Three, players may now call out either the number, letter, first name or last name of another player in the circle.", "gimmicks": "'A' should give a call of \"Ready?\" before starting. The purpose of the game is concentration and listening, so it's pointless to call on a player when they haven't had the chance to figure out who they are. If they forget who they are, then by all means punish them. Beyond Round Three, acceleration, and a stricter enforcement of rhythm are good ways to increase difficulty.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-eat-my-sandwich", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Eat_My_Sandwich", "create": true, "replacePlaceholder": true, "name": "Eat My Sandwich", "category": "Warm-Up", "tags": "Warm-Up", "description": "\"Eat My Sandwich\" is a rhythmic warm up. With slight variation, it also referred to as \"Shambooyah.\" For a more free-form version of this game, see \"Time Warp.\"", "howToPlay": "• For an example of the rhythm of this, see here - hover your cursor above the the text that says \"All Together\" at the top of the piece to find a play button). • Everybody in a circle. • Together, recite the refrain: \"Eat my sandwich, eat, eat, my sandwich. Eat my sandwich, eat, eat, my sandwich.\" • From there, one person improvises four lines of a phrase. • The first begins with \"My name is...\" • The next three all start with \"I,\" and they continue to describe whatever character has come out of the \"My name is...\" • Everybody repeats the refrain. • The next person in the circle improvises four line.", "variations": "The structure of this game depends on your intentions for it. Not every ensemble adheres to the rhythm delineated in the sheet music example. Some require that each line after the \"My name is...\" one begin with the word \"I\" (which is also indicated in the sheet music example). Some ensembles stipulate that your couplet must rhyme, usually adhering to an A B C B rhyme scheme. Some don't stress this and encourage it as an exercise in spontaneity, much in the style of \"Time Warp.\" The refrain of…", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-enemy-protector", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Enemy_Protector", "create": true, "replacePlaceholder": true, "name": "Enemy Protector", "category": "Warm-Up", "tags": "Warm-Up", "description": "Enemy Protector, also called Enemy Guardian or Protector, is a physical warmup. Each person secretly chooses one \"enemy\" and one \"protector.\" The goal is for each person to move himself to keep his protector between his enemy and himself.", "howToPlay": "Each person secretly chooses one \"enemy\" and one \"protector.\" The goal is for each person to move himself to keep his protector between his enemy and himself.", "variations": "This warmup can be played with additional restrictions, such as \"move very slowly\" or \"crawl around.\"", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-event", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Event%C3%A9", "create": true, "replacePlaceholder": true, "name": "Eventé", "category": "Long Form", "tags": "", "description": "The Eventé is a form revolving around a single event. The first scene establishes the event. That scene is followed by several more which focus on a particular character from the event. Then the event scene is performed again, taking into account new information discovered by the background scenes. This can be followed by more background scenes focusing on a different character, then a second return to the event, and so on.", "howToPlay": "• The Eventé was created and directed by improv mastermind Armando Diaz. The form is built around one central event -- an event suggested by a member of the audience. • Eventé debuted in the late 1990s at the UCB Theater. The original cast included: • Ari Voukydis • Brian Huskey • Celia Bressack • Rob Corddry • Lisa Jolley • Marian Rosin • Kurt Bumbulis • Tom Blake • Matt Stillman • Christine Walters", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-fairy-tale", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Fairy_Tale", "create": true, "replacePlaceholder": true, "name": "Fairy Tale", "category": "Long Form", "tags": "", "description": "The Fairy Tale format is an improv format taught at the Magnet Theater in New York. Despite the name,it doesn't need to be in the fairy tale genre In this format based on a Harold, players create a musical based on a single suggestion from the audience. It follows a simple story structure with heroes, villains, and charm characters. It’s about having fun and making bold choices.", "howToPlay": "• Get Suggestion • Ask the audience for one-word. • A Song to build out the world serving as an improv opening • Two or three players step out. One is the hero, and the others are sidekicks or supportive characters. The hero expresses their goal and what they want to achieve. The sidekicks can be supportive or less optimistic. The hero should be focused on making the world better. The sidekicks help drive this story forward, either by supporting or adding their own perspective. • I Want Song– This song represents the hero's desire, their “I want” moment, showing what the hero wishes to achieve and how they envision the world if their wish is fulfilled. • Two or three new players step out. • These characters have opposing views to the hero. They believe in their own philosophy, which stops the hero from achieving their goal. It's not about their plan. • Philosophy Song – The villain's song shows their philosophy. Their view of the world and why they believe they are right, no matter the cost. They have no doubts, unlike the hero. • Three new players step out. These characters aren’t heroes or villains, but they add to the world. They could be quirky or odd, and might not even know the villains and heroes. • Three person song – The charm characters sing a light-hearted or quirky song. • The scene starts optimistically. • The villain enters and shakes the hero’s confidence. • The…", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-feed-the-gator", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Feed_the_Gator", "create": true, "replacePlaceholder": true, "name": "Feed the Gator", "category": "Warm-Up", "tags": "Warm-Up", "description": "Feed the Gator is a physical and verbal warm up created by Krompf. Players stand in a circle. One person leaps into the middle and mimes wrestling a gator and forcing its mouth open with their hands. Someone then says \"I'm going to feed this gator...\" and names something. Someone else then feeds the gator another item, related to the first. The another person feeds the gator something related to the first two items, creating a pattern. Once everyone has fed the gator with objects following the established pattern, the gator is freed and someone else catches it and forces its mouth open.", "howToPlay": "• A: \"I'm going to feed this gator a tricycle!\" • B: \"I'm going to feed this gator a broken plastic army man!\" • C: \"I'm going to feed this gator a sandbox pail!\"", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-flock-of-seagulls", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Flock_of_Seagulls", "create": true, "replacePlaceholder": true, "name": "Flock of Seagulls", "category": "Warm-Up", "tags": "Warm-Up", "description": "Flock of Seagulls is a physical matching warmup, this also known as simply flocking or \"A Flock of Awesome.\" Players stand in a diamond shape, facing forward. The person who is farthest forward, who has no one in front of him, then starts to do some sort of physical action. Everyone copies these actions. If the person in front turns left, right, or backwards, causing everyone else to turn left, right, or backwards, then there is a new leader. Everyone matches the person who is now in the front of the diamond until he causes everyone to turn towards one of the other corners.", "howToPlay": "Players stand in a diamond shape, facing forward. The person who is farthest forward, who has no one in front of him, then starts to do some sort of physical action. Everyone copies these actions. If the person in front turns left, right, or backwards, causing everyone else to turn left, right, or backwards, then there is a new leader. Everyone matches the person who is now in the front of the diamond until he causes everyone to turn towards one of the other corners.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-flow-loko", "category": "Long Form|Opening", "tags": "Opening", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Flow_Loko", "create": true, "replacePlaceholder": true, "name": "Flow Loko", "description": "Musical or rhythmic opening that keeps a groove while ideas pile on.", "howToPlay": "It consists of a suggestion inspired monologue, which is interrupted by another improviser repeating a line of the monologue that can be used as a mantra. Then, said mantra is used to riff and develop premises. Originally, the suggestion came from a specific question inspired by whatever conversation the improvisers where having just before the beginning of the show.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-follow-the-follower", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Follow_the_Follower", "create": true, "replacePlaceholder": true, "name": "Follow the Follower", "category": "Warm-Up", "tags": "Warm-Up", "description": "No one leads. Mirror the group’s movement and sound until the room is one organism.", "howToPlay": "Follow the Follower can serve as an Organic Opening to a performance. Many teams, notably the PIT's Borealis, will perform the exercise to music to generate ideas for the rest of their set.", "gimmicks": "To practice listening and observing each other. To make big physical choices. To trust that things will happen when you're not pushing/driving.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-form-2", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Form_2", "create": true, "replacePlaceholder": true, "name": "Form 2", "category": "Long Form", "tags": "", "description": "Paint a vivid still image from a location suggestion, then play scenes that lead up to recreating that picture.", "howToPlay": "• Suggestion taken for a form is usually a location or an event. The actors then quickly paint the scene, each in turn describing one or two objects in the scene. The description is not limited to physical objects, but can also specify moods, actions, and a general atmosphere of what is going. This creates a snap shot of the scene. • The group then begins a series of scenes that come together to form a story that leads up to the scene captured during initial scene painting. The last scene of the form is the originally painted scene. This last scene should, at some point, replicate as exactly as possible the original picture, though it doesn't have to end there. Actors usually limit themselves to one or two characters, to help keep the story coherent. • It generally helps to start somewhere completely unrelated to the painted scene - this gives the group many more options for crafting a storyline. Along the way, objects painted in the beginning are given a backstory and significance, so that in the end there is a reason for why they are in the scene.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-fortunately-unfortunately", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Fortunately,_Unfortunately", "create": true, "replacePlaceholder": true, "name": "Fortunately, Unfortunately", "category": "Warm-Up", "tags": "Warm-Up", "description": "Two (or more) voices tell one story, alternating Fortunately… / Unfortunately…", "howToPlay": "• A: \"I found a wallet on the street today.\" • B: \"Unfortunately, it didn't have any money in it.\" • C: \"Fortunately, it was a lady's wallet, and it had her phone number in it!\" • D: \"Unfortunately, there was a picture of her inside it, and she was pretty ugly.\" • E: \"Fortunately, that was her 'before' picture, and now she's looking great after all that plastic surgery\" • A: \"Unfortunately, when I called her there was no response.\" • B: \"Fortunately, it turns out she has the clap, and it's a good thing we never did it.\"", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-fred-schneider", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Fred_Schneider", "create": true, "replacePlaceholder": true, "name": "Fred Schneider", "category": "Warm-Up", "tags": "Warm-Up", "description": "Fred Schneider or Hey, Fred Schneider is a verbal warmup. The game starts out by players standing around in a circle and asking, to a rhythm, \"Hey Fred Schneider, what are you doing?\" Then one at a time, people sing a non-sequitur line in the voice of Fred Schneider, the lead singer of the B-52's. After a person answers the question, he poses the question to somebody else.", "howToPlay": "• Due to complaints that the original version of Fred Schneider was essentially about standing around thinking of something funny to say, Amey Goerlich came up with a version of Fred Schneider that allows the player to replace \"Fred Schneider\" with anyone or anything. The next person then responds as that character. • Play does need to go in a circle, either. Players can direct their question at anyone in the circle, so that the group has to constantly pay attention. • A: Hey there ghost, what are you doing? • B: (in a spooky voice) Haunting up a mansion and scaring some people! • B: Hey there surgeon, what are you doing? • C: Doing lots of surgery because that's what I get paid for! • C: Hey there Crispin Glover, what are you doing? • D: Acting bit parts of movies you've never heard of! • D: Hey there chihuahua, what are you doing? • A: yip yip yip yip yip yip yip", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-funeral", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Funeral", "create": true, "replacePlaceholder": true, "name": "Funeral", "category": "Long Form", "tags": "", "description": "Funeral is an improv form that lies somewhere between longform and shortform. In addition to being a performance worthy, it is also used as a character exercise in workshops.", "howToPlay": "• The Funeral format can be played with any number of improvisers. Perhaps 8 to 10 is a good number. The structure is the following: • Death intro scene • Funeral anecdote story • Flashback to anecdote • Return to funeral service, repeat • The suggestion taken for the Funeral is a peculiar way to die. With this idea to work from, the first scene performed is one of the improvisers dying this improbable death. This scene should be relatively short, as it is launching pad for the rest of the form. The scene should be wiped when someone has died using the suggestion. • We are then taken to the funeral of this dead person, and the stage picture is as follows: the improviser who died, lying center stage in his/her coffin, and the rest of the improvisers on the back line, as characters from the dead person's life. One person from the back line then comes up to a pantomimed podium, and gives the beginning of an anecdotal story that they shared with the person who has died. It shouldn't be too full of a story - think more along the lines of a premise or suggestion. • It should be kept brief because, after they have given enough to inspire something, this monologuing improviser wipes the stage and takes us to that event. There can and should be multiple characters involved in each scene. After the scene has played out, someone wipes the stage, returning us to the funeral service, where…", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "jam-george", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=George"}, {"tab": "Games", "id": "irc-get-up-get-down", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Get_Up_Get_Down", "create": true, "replacePlaceholder": true, "name": "Get Up Get Down", "category": "Warm-Up", "tags": "Warm-Up", "description": "Get Up Get Down is a physical warmup created by David Christopher of Just The Funny. Players stand in a circle. The group chants in a melodic way, \"Get up. Get down. Make a movement and make a sound.\" During \"get up\" everyone raises their hands and stretches to the ceiling. During \"get down\" everyone reaches and bends to the floor. During \"make a movement\" everyone does a simple dance move (all the same). During \"make a sound\" everyone cups their hands around their mouths.", "howToPlay": "• Everyone: \"Get up! Get Down! Make a movement and make a sound!\" • A: [takes one step forward and honks like a goose] • Everyone: [takes one step forward and honks like a goose two times] • Everyone: \"Get up! Get Down! Make a movement and make a sound!\" • B: [leans in with hands on sides of face and shrieks] • Everyone: [leans in with hands on sides of face and shrieks two times] • Everyone: \"Get up! Get Down! Make a movement and make a sound!\" • And so on...", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-give-me-back-my-son", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Give_Me_Back_My_Son", "create": true, "replacePlaceholder": true, "name": "Give Me Back My Son", "category": "Warm-Up", "tags": "Warm-Up", "description": "Players in a circle, one in the middle. The one in the middle must approach players one at a time and yell \"Give me back my son!\" in the over-dramatic style of Mel Gibson in the movie \"Ransom.\" If the player on the outside of the circle laughs, then that player becomes the player in the middle.", "howToPlay": "Many people try to make this warm-up into more than it is by responding to the line, or delivering the line with another emotion. This may undercut the simple beauty of the warm-up.", "gimmicks": "To practice emotional commitment, even when doing something silly. And to make your teammates laugh.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "jam-goon-river", "category": "Opening", "tags": "Opening", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Goon_River"}, {"tab": "Games", "id": "jam-harold", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Harold"}, {"tab": "Games", "id": "ie-hot-spot", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Hot_Spot"}, {"tab": "Games", "id": "irc-hot-tamale", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Hot_Tamale", "create": true, "replacePlaceholder": true, "name": "Hot Tamale", "category": "Long Form", "tags": "", "description": "The Hot Tamale is a derivation of the Tamale, and developed by Travis Ploeger for his show, iMusical: The Improvised Musical. It served as the opening format to most of their shows for the first 18 months of their run. Using the suggestion of a location, a scene begins. At some satisfying point, the pianist will begin underscoring the scene. This is a cue for Improviser A (within the scene) to initiate a tagline song. Improviser A sings two verses of this song, within the scene. The scene is edited into another scene, with completely different characters, with music continuing underneath. At some satisfying point (but not too long into the scene), Improviser B (within the scene) will sing a…", "howToPlay": "Using the suggestion of a location, a scene begins. At some satisfying point, the pianist will begin underscoring the scene. This is a cue for Improviser A (within the scene) to initiate a tagline song. Improviser A sings two verses of this song, within the scene. The scene is edited into another scene, with completely different characters, with music continuing underneath. At some satisfying point (but not too long into the scene), Improviser B (within the scene) will sing a third verse to the song, using the EXACT same tag as Improviser A. Other improvisers (except Improviser A) tag out anyone else apart from Improviser B, and begin a new scene around Improviser B. Improviser B is the same character as before. At some satisfying point (but not too long into the scene), Improviser B will sing the bridge to the song. The scene is edited into another scene which must initially include Improviser A, with music continuing underneath. At some satisfying point (but not too long into the scene), Improviser A will sing the final verse to the song. As the final verse is sung, the other improvers fade off stage. After Improviser A sings the tag, Improviser B joins her onstage to set up a…", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-impression", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Impression", "create": true, "replacePlaceholder": true, "name": "Impression", "category": "Warm-Up", "tags": "Warm-Up", "description": "Impression is a warm up created by a member of Shit-storm. Everyone stands in a circle, and one person says \"I heard (blank) does the greatest impression of (blank)\" That person then must do the impression as well as possible. After the impression, everyone says cheers and says \"That was amazing!\" The person who just did the impression then asks someone else to do an impression.", "howToPlay": "Impression is a warm up created by a member of Shit-storm. Everyone stands in a circle, and one person says \"I heard (blank) does the greatest impression of (blank)\" That person then must do the impression as well as possible. After the impression, everyone says cheers and says \"That was amazing!\" The person who just did the impression then asks someone else to do an impression.", "gimmicks": "Impression is an exercise in commitment and group support.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-invention-spelling-bee", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Invention_Spelling_Bee", "create": true, "replacePlaceholder": true, "name": "Invention Spelling Bee", "category": "Warm-Up", "tags": "Warm-Up", "description": "\"Invention Spelling Bee\" is an exercise that focuses on spontaneity and group-mind. It's a wonderful warm up.", "howToPlay": "• Improvisers make a tight circle around the initial leader of the exercise. The only instruction given is the following: \"When I point to you, give me a letter.\" • Point to a handful of improvisers, collecting enough letters for a newly-invented word. Perhaps 5 or 6 will do for your first one. • When you've got enough letters, point to someone and ask them to pronounce the word that has just been invented by the group. • Have a few people repeat the word, letting everybody remember it • From here on out, there is no regimented format for the game. Continue pointing to individual people and ask them questions about this word that may or may not be asked in a spelling bee. • Once you have asked what you feel is enough questions, point to someone and ask them to spell the word again. This person then replaces the leader in the middle of the circle, and the exercise begins anew. • T • U • O • O • H • R • T • Each question, like the letters, is addressed to a different person. • \"What word did we just spell?\" • \"Tuoohrt\" • \"What part of speech is this word? • \"An adjective.\" • \"What is the definition of 'Tuoohrt'?\" • \"Painstakingly slow.\" • \"Use 'Tuoohrt' in a sentence.\" • I was enraged by the tuoohrt fashion in which my computer downloaded the software.\" • \"Who was the first person to use this word in all of history?\" • \"Frank Ocean.\" • \"What were the circumstances in which Frank…", "gimmicks": "It is, of course, no problem at all if the word is not re-spelled exactly as it was the first time. Don't limit yourself to the questions given in the example. Encourage inhibition in this game. Any answer to any question is correct. The first leader may instruct at the very top of the exercise \"I am the facilitator, and you are the experts. That's all you have to know. When I point to you, give me a letter.\" This sets a nice tone.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "ie-invocation", "category": "Opening", "tags": "Opening", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Invocation"}, {"tab": "Games", "id": "irc-jump-stitch", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Jump_Stitch", "create": true, "replacePlaceholder": true, "name": "Jump Stitch", "category": "Long Form", "tags": "", "description": "=History= Jump Stitch was originated by a Level 6 Class -- Alan Becker, Clint Taylor, Crystal Jackson, Fálki Heiđdóttir, Jonathan Chavez, Kevin McCormick, Matthew Hall, and Steve Circeo -- at Bexar Stage. The original form was created by Steve Circeo, and it was adapted during rehearsals and a run of shows by the entire class, with help from the class's instructors, Tina Jackson and Lex Simpson. Jump Stitch incorporates elements of Action Theater during musical-dance interludes. The idea to start the next scene with the last line of the previous scene was suggested by Kevin McCormick, as that device was part of a form he was constructing. Jump Stitch was performed by the Level 6 Class…", "howToPlay": "Jump Stitch was performed by the Level 6 Class, which also called themselves Jump Stitch, four times in October-November 2019. =Structure= Jump Stitch is generally done in a 20-25 minute block and consists of three beats, with a musical-dance interlude between each beat. The team starts backstage and does not ask the audience for a suggestion. The stage is dark as music starts playing. A slow tango works well, and the original song used by Jump Stitch was \"Santa Maria (del Buen Ayre)\" by Gotan Project.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-knife-throwing", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Knife_Throwing", "create": true, "replacePlaceholder": true, "name": "Knife Throwing", "category": "Warm-Up", "tags": "Warm-Up", "description": "Knife Throwing is a warmup. Players stand in a circle. One person mimes throwing a knife at another person, who then claps their hands, as if they had grabbed the knife just before it hit them. That person then throws the knife at someone else.", "howToPlay": "Knife Throwing is a warmup. Players stand in a circle. One person mimes throwing a knife at another person, who then claps their hands, as if they had grabbed the knife just before it hit them. That person then throws the knife at someone else.", "gimmicks": "Attentiveness, watching your scene partners, and reacting to everything in your space.", "variations": "Multiple knives can be thrown. The knives can also morph into other objects, such as kittens, bowling balls, and balloons. The thrower can scream \"Die!\" in an intense voice. The catcher can yell \"Not today!\" in response.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "jam-la-ronde", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=La_Ronde"}, {"tab": "Games", "id": "irc-lovefest", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Lovefest", "create": true, "replacePlaceholder": true, "name": "Lovefest", "category": "Warm-Up", "tags": "Warm-Up", "description": "A warm-up intended to cement bonds among team members, put them in a positive frame of mind and get them \"yes-anding.\" Stand in a circle and explain why you like someone else in the circle, making up a reason. That person yes-ands that compliment, then explains why she likes someone else in the circle.", "howToPlay": "• VIOLET: Here's why I like Margot so much. She gave me this coonskin cap. I've been wearing it constantly. And she skinned the 'coons herself. • MARGOT: It's true. I did skin the 'coons to make her a coonskin cap. And you know who shot them? Zohar. A big 'coon was coming after me. Zohar saved my life. • or • BRETT: Let me tell you something about Sarah. I had a really important job interview and I was running late...so I went up to her apartment and she let me use her jet pack so I could get there in time. • JEFF: Aww...your brand new jet pack? • SARAH: It's true. I'd just gotten it.... • Devised by Jeff Scherer when a new team was put together to perform The Documentary. A regular warm-up for The Locals.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-lumberjack", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Lumberjack", "create": true, "replacePlaceholder": true, "name": "Lumberjack", "category": "Warm-Up", "tags": "Warm-Up", "description": "Lumberjack is a physical concentration warmup. Players stand a circle. One person is a tree; he puts his arms straight up. The people on either side of the tree mime chopping down the tree. As the tree falls, he points to someone else, who is the new tree.", "howToPlay": "Players stand a circle. One person is a tree; he puts his arms straight up. The people on either side of the tree mime chopping down the tree. As the tree falls, he points to someone else, who is the new tree.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-mansplaining", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Mansplaining", "create": true, "replacePlaceholder": true, "name": "Mansplaining", "category": "Long Form", "tags": "", "description": "Mansplaining is a long form improv challenge based game performed at The Bit Theater", "howToPlay": "Mansplaining is a long form improv challenge based game performed at The Bit Theater", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-midnight-society", "category": "Warm-Up|Opening", "tags": "Opening|Warm-Up", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Midnight_Society", "create": true, "replacePlaceholder": true, "name": "Midnight Society", "description": "Campfire / secret-society opening that frames the set as a story being told.", "howToPlay": "• Get a suggestion of anything at all. • Make a Crescent of Doom: Players initiate a campfire scene • A player starts by telling us that they have a scary story to share and gives us the basic premise of the story in a line or two. • Other players add on to the story. Everyone behaves as if this is the scariest story EVER. • Once we have the basic gist of it, a player steps out to make the story scenic. We see a three to four line scene, moving the action along. • Players physically move back to indicate a return to the Crescent of Doom. Another player tells us about another scary story - based off the original suggestion. • We tell three stories. • Remember after the little scenes to comment on the new details discovered. • At the end of the third detail discussion, we all say together: \"submitted for the approval of the midnight society, we give you.... (SUGGESTION)!\" • First, get a suggestion of anything at all: a word, a phrase, whatever comes to mind. • Once you have that, everyone forms the Crescent of Doom, standing in a semi-circle like they’re around a campfire. Use object work to sell the setting. Pretend to warm your hands, poke at the fire, or hold a mug of something hot, etc. • You can establish some fun, tropey campfire characters. For example, someone might act brave, another might be a scaredy cat, and someone else could be the know-it-all who swears the…", "gimmicks": "Midnight Society is a game where we tell spooky, weird, or silly stories as if we’re sitting around a campfire. The goal is to tell three different stories based on a suggestion and act out little scenes from each one. It’s great for practicing stage picture, verbal edits, strong initiations, and building on details. It can be used as a warm-up, an exercise, or an opening for a show.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "jam-mindmeld", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Mind_Meld"}, {"tab": "Terms", "id": "term-monologue", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Monologue"}, {"tab": "Games", "id": "jam-the-monoscene", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Monoscene"}, {"tab": "Games", "id": "ie-montage", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Montage"}, {"tab": "Games", "id": "irc-mr-hit", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Mr._Hit", "create": true, "replacePlaceholder": true, "name": "Mr. Hit", "category": "Warm-Up", "tags": "Warm-Up", "description": "==History==\nTaught by Eric Davis in his clowning class at the PIT. ==Directions==\n===Part 1===\nPlayers form a circle. One Player says, \"I'm Mr. Hit\" and then taps someone on the shoulder or stomach.", "howToPlay": "• Players form a circle. One Player says, \"I'm Mr. Hit\" and then taps someone on the shoulder or stomach. Then the player that has been tapped says the name of another player in the circle. The player, whose name has just be called, then taps another player in the circle. The pattern continues till someone messes up by either tapping a player when they should say a player's name or saying a player's name when they should be tapping a player. • When a player has messed up they are no longer in the circle. Now they can wonder around the outside the circle, tapping players and saying players' names at random in an attempt to mess up the remaining players. This continues till there are only two players left although some enjoy trying to play till there is only one player left.", "gimmicks": "While this game is great at creating laughs and energy. The main purpose of this game is to force concentration in a chaotic enviornment. Near the end of the game everyone on the outside is tapping the few players left in the circle and yelling their names. At this point it becomes difficult for the remaining players to concentrate on what is happening inside the circle. If they maintain their concentration, they win. If they don't, they lose.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-muppet-faces", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Muppet_Faces", "create": true, "replacePlaceholder": true, "name": "Muppet Faces", "category": "Warm-Up", "tags": "Warm-Up", "description": "All participants create a circle by wrapping each others' arms around their shoulders, facing inward. The \"Leader\" suggests an emotional situation or state of being that could be personified by a Muppet (e.g., Jealous Muppet, Nervous Muppet, Orgasmic Muppet, Last Breath Muppet, etc.). All bow their heads and focus on the floor in the center of the circle. The Leader counts aloud to three at a marching pace. During the counting of the Leader, participants silently and secretly choose another participant (without alerting that participant). In the space where the Leader would (but doesn't) say the number four, the participants look up and attempt to lock eyes with their choice. If a…", "howToPlay": "Some notes about Muppet Faces: This can be done with just one suggestion, or by changing suggestions after a satisfying amount of turns. The Leader may also be a participant.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-musical-improv", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Musical_improv", "create": true, "replacePlaceholder": true, "name": "Musical improv", "category": "Long Form", "tags": "", "description": "Musical improv is improv where lyrics and/or melodies are created in the moment. In musical improv, performers create all of the lyrics on the spot most often with live music accompaniment. This includes short-form games and long-form shows that attempt to re-create musical theater using improv. For more, see :Category:Musical Improv", "howToPlay": "• Beastie Boys Rap • Bad Rap • Hot Spot • Tagline song • Verse/chorus songs • Baby Wants Candy - Chicago, IL • Freestyle Love Supreme - Broadway rap improv show created by Lin-Manuel Miranda, Thomas Kail, and Anthony Veneziale • iMusical - Washington, DC • North Coast - New York City • Rumpleteaser - New York, NY • Thank You, Places - Philadelphia, PA • Play It By Ear - Dropout.TV Musical Improv Series • The New York Musical Improv Festival (NYMIF) is a four-day festival held at the Magnet Theater in New York City. • How to Write Funny Lyrics: The Comedy Songwriting Manual • Musical Direction for Improv and Sketch Comedy • Musical Improv Comedy: Creating Songs in the Moment • Instant Songwriting by Nancy Howland Walker", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "jam-one-word-story", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=One_Word_Story"}, {"tab": "Games", "id": "irc-oracle", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Oracle", "create": true, "replacePlaceholder": true, "name": "Oracle", "category": "Long Form", "tags": "", "description": "A strange form used in class by Del Close where one player would be designated as the oracle. The other players would be like the priests of ancient Greece. First they would gather an important question to explore from the audience. Then they would create a ritual around the oracle, attempting to put that player into a trance like state. This could go on for some time, until the player would erupt into a stream of conscious babel, filled with non-sequitors, gibberish and random thoughts that might in some way be connected to the original question. Once the oracle is spent, the players would then interpret the oracle by creating scenes based on what the oracle said. On some occasions, Del…", "howToPlay": "A strange form used in class by Del Close where one player would be designated as the oracle. The other players would be like the priests of ancient Greece. First they would gather an important question to explore from the audience. Then they would create a ritual around the oracle, attempting to put that player into a trance like state. This could go on for some time, until the player would erupt into a stream of conscious babel, filled with non-sequitors, gibberish and random thoughts that might in some way be connected to the original question. Once the oracle is spent, the players would then interpret the oracle by creating scenes based on what the oracle said. On some occasions, Del would encourage us to attempt to draw conclusions from the scenes to answer the original question as a way to end the piece.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-organic-opening", "category": "Long Form|Opening", "tags": "Opening", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Organic_opening", "create": true, "replacePlaceholder": true, "name": "Organic opening", "description": "No preset game. The group discovers an opening together from the suggestion — sound, movement, or talk — then uses that discovery to start scenes.", "howToPlay": "• Although an organic opening can take many forms, it is often when an improv team takes an audience suggestion uses it to start moving and creating sounds related. The performers follow each other's lead and attempt to create ideas for scenes and characters. It's very similar to Follow the Follower. • Typically during this opening a team will go through two loops or bunny ears, going away from the suggestion and then back twice. • The goal is to move from more abstract movements to concrete clear movements. This is often aided by members of the team shouting out what they're doing or labeling the action. • It's common to see teams breaking out into tableaus where everyone on the team becomes part of a setting, being a character, an inanimate object, or whatever is appropriate in the setting. During these tableaus people can and often do speak lines of dialogue, although not many so that they don't use up potential game beats.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "ie-pass-clap", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Pass_the_Clap"}, {"tab": "Games", "id": "irc-pass-the-phrace", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Pass_the_Phrace", "create": true, "replacePlaceholder": true, "name": "Pass the Phrace", "category": "Warm-Up", "tags": "Warm-Up", "description": "Pass a made-up phrase around the circle, keeping the sound even as it mutates.", "howToPlay": "Everyone stands in a circle. One person starts by turning to the person next to them and making a face/pose while saying a phrase. The person who receives this \"phrace\" turns to the person next to them and passes it along as fast as they can. As the \"phrace\" continues around the circle, it can evolve into gibberish, and then into whole new phrases and faces/poses.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-pattern-game", "category": "Long Form|Opening", "tags": "Opening", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Pattern_Game", "create": true, "replacePlaceholder": true, "name": "Pattern Game", "description": "Classic verbal opening. Riff on the suggestion in a circle, find repeating patterns and unusual ideas, then edit into scenes.", "howToPlay": "Example: Audience suggests \"ice cube.\" The team might associate this way: ice cube scotch advertising executive 1950s New York double-breasted suit living in the past FDR Halloween costume Toy wheelchairs grounded rinse your mouth out with soap ice cube And repeat twice more. Some refer to the concept of circuitously exploring the idea of a word and making it back to the original word as \"drawing a cloverleaf\". In the above example, the journey from \"ice cube\" through each associated phrase and back to \"ice cube\" could be visualized as the drawing of a single leaf. Repeating this two or three more times, always using \"ice cube\" as a center point\" could be visualized as a clover with a few different leaves.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-photogravure", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Photogravure", "create": true, "replacePlaceholder": true, "name": "Photogravure", "category": "Long Form", "tags": "", "description": "The Photogravure form was created by Miki Manting. It uses old photographs as inspiration. The photographs spark monologues, which, in turn, inspire two-person scenes. The improv team Sonic Boom-Boom has further adapted the form.", "howToPlay": "The Photogravure form was created by Miki Manting. It uses old photographs as inspiration. The photographs spark monologues, which, in turn, inspire two-person scenes. The improv team Sonic Boom-Boom has further adapted the form.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-picture-perfect", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Picture_Perfect", "create": true, "replacePlaceholder": true, "name": "Picture Perfect", "category": "Long Form", "tags": "", "description": "Picture Perfect is a long form show that incorporates audience submitted photos as inspiration for the scenes. The show is performed at The Bit Theater", "howToPlay": "Picture Perfect is a long form show that incorporates audience submitted photos as inspiration for the scenes. The show is performed at The Bit Theater", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-premise-keepers", "category": "Long Form|Opening", "tags": "Opening", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Premise_keepers", "create": true, "replacePlaceholder": true, "name": "Premise keepers", "description": "Premise Keepers is an opening similar to a the living room opening and a modified pattern game. From the suggestion, the players immediately pitch their thoughts and ideas either linked to the suggestion or through an A to C connection. This continues until players find a possible premise or unusual thing theythink could be funny. Players immediately initiate a scene.", "howToPlay": "This continues until players find a possible premise or unusual thing theythink could be funny. Players immediately initiate a scene. The opening was developed for Matt Besser's show \"Premise Keepers\" which returns to the opening for new ideas throughout the set.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-rant", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Rant", "create": true, "replacePlaceholder": true, "name": "Rant", "category": "Warm-Up", "tags": "Warm-Up", "description": "Rant is a character matching warmup. Players stand in a circle. One person steps in the middle and starts to deliver a a fictional first-person monologue. At any point, another player may tag in and continue the monologue, trying to heighten any emotion present. People should not tag in to invent new things, but to continue the previous things, heightened.", "howToPlay": "Players stand in a circle. One person steps in the middle and starts to deliver a a fictional first-person monologue. At any point, another player may tag in and continue the monologue, trying to heighten any emotion present. People should not tag in to invent new things, but to continue the previous things, heightened. This usually takes the form of an angry rant.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "jam-red-ball", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Red_Ball"}, {"tab": "Games", "id": "irc-rotary", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Rotary", "create": true, "replacePlaceholder": true, "name": "Rotary", "category": "Long Form", "tags": "", "description": "Rotary is an improvised podcast and longform improv format that primarily features phone calls between characters. The format is also known as the \"Telephone\". Rotary was created by Katy Meeks and is directed/coached by Zander Frost. It stars Katy Meeks, Andy Barrett, Adler Davidson, Bobby McCosky, and Rosie Caruth.", "howToPlay": "• The Rotary improv format was initially conceived in March 2020 by Katy Meeks, and was developed further by Katy Meeks, Zander Frost, Andy Barrett, Adler Davidson, Bobby McCosky, and Rosie Caruth. It takes inspiration from the La Ronde, Slacker, Macroscene, and Harold. It lasts around 25-30 minutes and begins organically with a single world suggestion. • Before it was fully developed, the original format simply followed a chain of phone calls in the pattern of a La Ronde. • The first and core section of the Rotary form consists primarily of phone calls between characters. Scenes in this section typically last between two and three minutes, and are usually edited by one of the characters receiving an incoming call. Calls are made by another member of the team saying \"ring ring [player's] phone.\" The character receiving the call hangs up and answers the incoming call. Scenes may also be edited by door knocks, walk-ons, or any move that allows the show to continue in real-time (no time jumps). Stylistically, most scenes in this phase have their own distinct game of the scene; a voice of reason in one scene may become the absurd character in the next scene and vice versa. • At around 17:00, the group begins to look for an opportunity to rapid fire call one character. This section lasts for around three minutes and acts as a bridge and energy spike between phases one and three. •…", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "ie-samurai", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Samurai"}, {"tab": "Games", "id": "ie-scene-painting", "category": "Opening", "tags": "Opening", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Scene_Painting"}, {"tab": "Games", "id": "irc-scramble", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Scramble", "create": true, "replacePlaceholder": true, "name": "Scramble", "category": "Long Form", "tags": "", "description": "The Scramble is a longform improvisational format that features overlapping scenes and chaos on stage. The Scramble is confusing and chaotic. Improvisers are encouraged to stir up disorder on stage. Improvisers are encouraged to embrace the confusion and understand that they cannot understand everything that is happening on stage. The Scramble is up for the audience to interpret and absorb. The show may or may not start with an opening and typically begins with a solo start. From there, improvisers may use several techniques to create a world of overlapping scenes.", "howToPlay": "• There are at least six techniques used in the Scramble: • Solo Starts: One player makes a big physical and emotional choice on stage. Interacting with an invisible character that is in the scene. Improvisers should leave some space for lines to land with that other character and to react to what that invisible character is saying in response. • Overlap Edits: Someone initiates a solo start on top of the scene (or scenes) that are already inhabited and taking place on stage. Overlap Edits lead to stacked scenes. • Stacked Scenes: Stacked scenes are when there is more than one scene taking place at the same time on stage aka multiple scenes on top of each other/using the same space on stage. Stacked scenes are a great way to playfully violate the location/object work reality of other scenes. It’s really helpful for each scene (while they’re stacked) has their own specific vibe, energy, tone, etc. so as to get contrasts in scenes going on (which will add some texture to what’s going on). • Bolts: To bolt means to definitively leave a scene (by breaking eye contact and leaving with intent) as the performer, while understanding that the character that was inhabited by that performer, is still in that scene. This is a great way to leave a scene in the hands of the other performer(s) in the scene, especially if the emotion has gotten so high that (in the reality of that scene) it…", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-seven-things", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Seven_Things", "create": true, "replacePlaceholder": true, "name": "Seven Things", "category": "Warm-Up", "tags": "Warm-Up", "description": "Point at a player: they must name seven things in a category before the group counts them out.", "howToPlay": "While it is good for the list of seven things to be as accurate as possible, the player's primary goal is to name items confidently so that they sound like real answers (because in a scene you may be playing an expert in a field you know nothing about) and to maintain the rhythm of the exercise. It is not uncommon for a player to have to make up items toward the end of the list, even when the category is not very esoteric. It is important that the group counts off as items are named, as players frequently keep going beyond seven items if left unchecked. = Variants = The goal can be a different number of things, such as three or ten. In Chicago, \"Five Things\" is the most common version played.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-shakesprov", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Shakesprov", "create": true, "replacePlaceholder": true, "name": "Shakesprov", "category": "Long Form", "tags": "", "description": "Structure 1. Opener, paint world: Monologue a) Performer asks for suggestion b) Audience gives suggestion c) Performer does monologue about topic which sets up scene for the rest of the performance d) Everyone goes to sides 2. Act 1 (aka beat 1, long scene) a) Someone with a good idea about monologue initiates a scene with someone else b) Other performers continue scene c) Conflict concerning topic presents itself to protagonist d) Once that happens, act ends by someone clapping 3. Spin-off scene (reaction to beat) a) Anyone with an idea for a spin-off scene (pun/one-liner, game, really short scene, etc. that relates to the world, character, or topic of the previous long scene but doesn’t…", "howToPlay": "Rules 1.The characters established in the first beat (Act I, II, and III) must stay the same through the other two, but new characters may arise during spin-off scenes and poem 2. The protagonist is defined as whoever changes most from beginning to end 3.Shakespeare was a good wordsmith, and you’re not. No excessive expletives. 4. No attacking groups of people. Duh. A Note About Shakesprov Though it might not be readily apparent, this form of improv was inspired by the works of William Shakespeare. Specifically, the three beats – called Acts – mirror the plotlines of Shakespeare’s plays. The monologue at the beginning is something commonly found in his plays, as well, usually called a soliloquy. Though Shakespeare never wrote haikus (that we know of), he did write sonnets that became an important part of his literary legacy. The mandatory breaking of the fourth wall at the end of our show is something that occurs in many Shakespeare plays, such as Midsummer Night’s Dream and The Tempest.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-shay-shay-koolay", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Shay_Shay_Koolay", "create": true, "replacePlaceholder": true, "name": "Shay Shay Koolay", "category": "Warm-Up", "tags": "Warm-Up", "description": "Shay Shay Koolay or Shay Shay Coolay is a physical warm up.", "howToPlay": "Shay Shay Koolay or Shay Shay Coolay is a physical warm up.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-shopkeeper", "category": "Warm-Up|Opening", "tags": "Opening|Warm-Up", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Shopkeeper", "create": true, "replacePlaceholder": true, "name": "Shopkeeper", "description": "Opening or scene: a shopkeeper and customers riff on the suggestion as inventory and requests.", "howToPlay": "• The customers enter the scene one by one, each with a specific emotion, like happy, sad, or angry, and an item, like a book, shoes, or a guitar. • The customer’s task is to convey both the emotion and the item without directly saying what the item is. They can give clues through body language, tone of voice, and vague descriptions. • The shopkeeper’s role is to pick up on the customer’s emotional state and match it, while guessing the item through conversation and observation. The shopkeeper can ask questions or offer suggestions to narrow down the possibilities. • Example: Player 1 is the shopkeeper. Player 2 is assigned the emotion \"nervous\" and the item \"rollerskates.\" • Player 2 enters, looking around anxiously and wringing their hands. They say things like, \"I-I really need something... fast.\" They might act hesitant, shifting their weight and avoiding eye contact. • Player 1, as the shopkeeper, notices Player 2’s nervousness and mirrors it, speaking in a gentle tone, “I can help you with that. What exactly are you looking for?” • Player 2 might respond, “It’s for... moving... moving fast!” Their gestures could show quick, jerky motions or a sense of urgency. • Player 1 guesses, “Are you looking for, um... a bicycle?” • Player 2 shakes their head and adds, “No, it’s more like... you put your feet in it... and go?” • At this point, Player 1 might guess again…", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "jam-the-slacker", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Slacker"}, {"tab": "Games", "id": "irc-sleep-over", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Sleep_Over", "create": true, "replacePlaceholder": true, "name": "Sleep Over", "category": "Long Form", "tags": "", "description": "The Sleep Over was the name of the form performed by Mother as part of their weekend show Wanna Sleep Over? at the UCBT from September 2001 through 2003.", "howToPlay": "• Sleep Over is, at its essence, a mono-character form. It has elements of monoscene, deconstruction, and La Ronde in it. • First, you get a suggestion of words of advice. That inspires some sort of inner truth or want that you repeat, mantra-like, until everyone is onstage repeating their inner \"thing\". Each actor choose and then repeats their mantras. One by one, each actor retreats to the back wall until only two are left. Those two repeat their inner \"thing\" one last time before engaging in scenework. • The scene is edited by the entire back line stepping forward in a pose and repeating their original mantras. One of the two characters then selects one of these \"statues\" who then initiates the scene. (Very important. This way the statue can't pre-plan an initiation). • This scene, and all subsequent scenes, are edited in the same way. The person selecting the statue can be anyone who's already been \"activated\" for a scene. • Once everyone has been introduced, characters mix and match with each other. • The trick is to NOT play plot, but instead play character and character want. That creates the illusion of plot. • In 2004, Mother's James Eason and Tara Copeland taught the Sleep Over as a performance class at the Upright Citizens Brigade Theatre. The show was called Pajama Party and ran for four Tuesdays in July. The cast consisted of Kate Billingsley, Gary Cohen, Robert…", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-smooth-jazz", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Smooth_Jazz", "create": true, "replacePlaceholder": true, "name": "Smooth Jazz", "category": "Warm-Up", "tags": "Warm-Up", "description": "\"Smooth Jazz\" is a warm up that's good for just about everything (group mind, energy, and focus).", "howToPlay": "• \"Smooth Jazz\" is a pass-the-focus exercise in the same vein as \"Superheroes,\" but it employs sound and movement combinations in place of people's names. It is also set to a more strict rhythm. • Everybody sitting in a circle. • A \"We Will Rock You\" rhythm is established: boom, boom, clap. boom, boom, clap. (Feel free to \"boom\" on your thighs.) • The group selects a category for their sound and movement combinations. A good place to start is \"animals,\" but it can be as abstract or realistic as you like. • Everyone in the circle, one by one, establishes their own personal combination in time with the \"clap\" section of the rhythm. • When you return to the initial leader, she sends focus by repeating someone else's sound and movement. • This person then sends focus by repeating a different person's sound and movement. • Etc. • Category: Money. 4 players. All combinations are debuted and repeated on the \"clap\" section of the rhythm. • Boom boom clap rhythm established. • Person 1: pantomiming a slot machine / \"ca-ching!\" • All repeat this combination. • Person 2: rubbing fingers for universal \"money\" gesture / \"oh yeah...\" • All repeat. • Person 3: throwing coins in the air / \"I'm filthy rich!\" • All repeat. • Person 4: cupping hands and frowning / \"spare some change?\" • All repeat. • All: pantomiming a slot machine / \"ca-ching!\" • All: rubbing fingers for universal \"money\"…", "gimmicks": "Start with a slow tempo. During the \"establishing\" round, repeat each person's combination as a group on the next beat. This helps everybody remember it. You may also elect to cycle through each of combinations as a group - everybody saying them in unison - before you proceed to use them to pass focus.", "variations": "Once you've played one category through to satisfaction, establish more. You can then mix them all together. In this variation, you would need to be prepared to respond when any of your combinations are called, regardless of the category. Also consider forbidding the use of real words in the sound section of the combination.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-sound-bomb", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Sound_Bomb", "create": true, "replacePlaceholder": true, "name": "Sound Bomb", "category": "Warm-Up", "tags": "Warm-Up", "description": "Sound Bomb is a musical warm up. Everyone stands in a tight circle and closes their eyes. One by one, people start singing, makes noises, or tapping out rythms trying to match each other to create one bomb of sound cohesive in tone and rythm. At various times someone can make a big choice to change it to a completely new set. Eventually, everyone has to nonverbally decide to end it together.", "howToPlay": "Sound Bomb is a musical warm up. Everyone stands in a tight circle and closes their eyes. One by one, people start singing, makes noises, or tapping out rythms trying to match each other to create one bomb of sound cohesive in tone and rythm. At various times someone can make a big choice to change it to a completely new set. Eventually, everyone has to nonverbally decide to end it together.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-spokane", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Spokane", "create": true, "replacePlaceholder": true, "name": "Spokane", "category": "Long Form", "tags": "", "description": "The Spokane is a longform. It is sometimes referred to as the Family Guy, Pretty Flower, or the Delicate Flower.", "howToPlay": "• The Spokane got its name because its structure resembles the spokes extending out from the hub of a wheel. It begins like a Monoscene: a suggestion is solicited from the audience, and a scene then commences that cannot be sweep-edited. Once this scene has been established, however, the use of tag edits is permitted to explore short tangential games or scenes. Each of these tangents is eventually swept edited, which returns the action to the source scene. These tangents can be thought of as the \"spokes\" extending out from the central hub of the source scene. In this way, the Spokane is a Monoscene in chapters, periodically broken up by short Montages. • The tangent sections often lend themselves to faster, goofier play a la tag runs or character games. The source scene is a counterbalance to this, as it is commonly taught as a more grounded, slow-moving section of the show. This combination makes for a pretty interesting form.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-steve-v-brain", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Steve_v_Brain", "create": true, "replacePlaceholder": true, "name": "Steve v Brain", "category": "Long Form", "tags": "", "description": "This form was created in Tucson, AZ by Street-Prov Theater Collective while exploring alternative formats for its show. It is named after Steven Aleck, a member of SPTC around whom the form officially revolved. Originally, the form held a strict cast of three people, with each person performing the same role in every show. Steven Aleck played Steve, Anthony Fama played Brain, and Boris Glebov played Everyone Else. The idea came about from the fact that in real life, Anthony frequently encouraged Steve to do outrageous and uncivil things. This dynamic was preserved in the show. Boris joined the format to provide a more physical backdrop of other characters. It was thought that having a full…", "howToPlay": "• Steve v. Brain has been referred to as \"a one-person show with three people in it.\" This is because Steve is the only character that was ground and real. • The form basically consists of a single scene in one location. There are three characters: • Steve - he is a reasonable and grounded person around whom all the action revolves. • Brain - Steve's brain. Brain was never physically present in scenes, existing only as a voiceover. In contrast to Steve's own rationality, Brain was outlandish, unhinged, and paranoid. It goes through extreme emotional swings, and constantly pushes and bullies Steve into doing things he normally wouldn't do. Brain can only be heard by Steve - Everyone Else is completely unaware of it. • Everyone Else - multiple characters played by one person. Everyone Else usually represented all that is absurd and ridiculous in the society that Steve has to deal with, frequently justifying Brain's paranoia.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-superheroes", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Superheroes", "create": true, "replacePlaceholder": true, "name": "Superheroes", "category": "Warm-Up", "tags": "Warm-Up", "description": "Warm-up or handle: endow each other with ridiculous superhero names and powers, then justify them.", "howToPlay": "After each person declares their superhero personae. The first player repeats his/her name and power, then says someone else's name/power. That person will say his/her name and power and then say someone elses. So it goes like this: Player 1: \"Captain Fists. (punches air). Atomic Gardner (mimes hoeing rapidly).\" Player who is Atomic Gardner: \"Atomic Gardner. (mimes hoeing rapidly) Backpack of Lightning (makes lightning bolt sound)\" Player who is Backpack of Lightning: \"Backpack of lightning (lightning bolt sound). Camera Man (says 'click').\" Repeat until tired.", "gimmicks": "To be silly. To make individual choices. To listen and remember other people's choices.", "variations": "Once everyone has a superhero, two people start saying their name so there are two \"threads\" being passed around at once. Or, everyone picks two superheroes so there's more to remember. Or, instead of superheroes, you say any silly combination of a phrase and gesture. \"Gimmie some pancakes (gobbling noise).\"", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-tamale", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Tamale", "create": true, "replacePlaceholder": true, "name": "Tamale", "category": "Long Form", "tags": "", "description": "The Tamale is a music improv form that was developed by Major 7th, and further used by Melodious Din and iMusical: The Improvised Musical. After soliciting a suggestion, an improviser delivers a monologue inspired by the suggestion. After a satisfying amount of time, the music director edits the monologue by playing music. Another improviser initiates and sings two verses of a tagline song, inspired by the monologue. After the second verse, two (or more) additional improvisers sweep edit into a one beat scenelette, inspired by the song, all while being underscored by vamping of the song. The singer edits this scene (generally about 15 to 30 seconds in length), and sings the bridge. Then two…", "howToPlay": "After soliciting a suggestion, an improviser delivers a monologue inspired by the suggestion. After a satisfying amount of time, the music director edits the monologue by playing music. Another improviser initiates and sings two verses of a tagline song, inspired by the monologue. After the second verse, two (or more) additional improvisers sweep edit into a one beat scenelette, inspired by the song, all while being underscored by vamping of the song. The singer edits this scene (generally about 15 to 30 seconds in length), and sings the bridge. Then two (or more) improvisers sweep edit again, and perform a second scenelette, again underscored with the song. The monologist edits this scenelette (again, after about 30 seconds or so), and sings the first line of the last verse of the song. Two other improvisers each sing one of the next two lines. The entire cast sings the tagline, which then repeats and ends the Tamale.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-the-convergence", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=The_Convergence", "create": true, "replacePlaceholder": true, "name": "The Convergence", "category": "Long Form", "tags": "", "description": "The Convergence was a UCBTNY Advanced Study Performance class taught by Kevin Hines. It ran on November 16, November 23, November 30, and December 7. The Convergence is about connections. The show is made up of long scenes -- each featuring a small cast -- that seem to have nothing in common. These scenes weave around each other building to a climax, feeding into each other more and more until finally their hidden secrets and layers will show how they are all connected. But mostly you will laugh.", "howToPlay": "The Convergence is about connections. The show is made up of long scenes -- each featuring a small cast -- that seem to have nothing in common. These scenes weave around each other building to a climax, feeding into each other more and more until finally their hidden secrets and layers will show how they are all connected. But mostly you will laugh.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-the-documentary", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=The_Documentary", "create": true, "replacePlaceholder": true, "name": "The Documentary", "category": "Long Form", "tags": "", "description": "Long-form with interviews, narration, and scenes, as if shooting a documentary about the suggestion.", "howToPlay": "• Initially, the form that came out of the first class was much like a Harold. There was an opening, several scenes involving two people interacting, followed by a group scene, second beats of the initial three scenes, etc. There were notable differences, though, including the use of narration at the beginning and throughout the Documentary, as well as interviews to an invisible camera, used to introduce characters for the first time. • Thus: • Suggestion: of a place or an event. • Opening: A sort of pattern game, where the cast members come up with fake factoids and character declarations inspired by the suggestion. The opening ends with a tagline and title for the Documentary. The fake factoids evolved into a run of true or made up facts, called the fact flurry (it usually follows the interview). • First beats: A short two-person interview to an invisible camera, followed by a scene between those two characters. • Group scene: More of the community, introducing peripheral characters. Recently, it has evolved to a series of monologues by characters that are part of the world examined by the documentary, called Enviromental testimonials. • Second beats. These are standard scenes, focused in the original pairs that were interviewed. They may also offer a confessional type of monologue, breaking the fourth wall. • Group scene 2. This can also be a documentarian walkabout, which…", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-the-frankie", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=The_Frankie", "create": true, "replacePlaceholder": true, "name": "The Frankie", "category": "Long Form", "tags": "", "description": "The Frankie is a longform improv form created by mexican improviser Francisco Antillón.", "howToPlay": "• The Frankie has the following structure: • An ask: Getting inspiration from a member of the audience, in the form of a song lyric that has a special connection for them. • Organic scenes: Three two-person scenes focused on discovery-based game of the scene. • Monologue: A monologue from either a cast member or a guest, inspired by the theme or situations explored in the organic scenes. • Premise based scenes: Three two-person scenes focused on premise-based game of the scene. Tag outs and other support moves are encouraged during this phase. • Group game: A group game inspired by either the monologue or the premise based scenes. • Connection rush: Quick scenes where characters from different scenes interact with each other. • What did we learn today?: Quick statements from each member of the cast regarding either specific ideas from scenes or general themes. • The intention behind the form is to explore different skills and approaches: Discovery-based improv, game of the scene, monologues, premise-based improv, group games, connections and theme.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-the-macroscene", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=The_Macroscene", "create": true, "replacePlaceholder": true, "name": "The Macroscene", "category": "Long Form", "tags": "", "description": "This improvised show is the culmination of a 600 level advanced study class at the UCBTNY. The Macroscene is a show made up entirely of seamless transformational edits in one macro-location. No sweeps! No tag-outs! No swinging doors! Instead, actors move from scene to scene using natural edits inherent in a scene. Creating a unique show that moves in real time and is free from improvisational editing.", "howToPlay": "• Below is an example of a show and the transitions it involved. This was performed by The Macroscene class on Jan.19 2010. • The games and scenes are not gone into great detail as this example is more to provide a sample of some in-show transitions. • The show opens in a hospital room with 2 patients who are visited by the make-a-wish foundation and celebrity super-model Cindy Crawford. • The patients, who asked for Derek Jeter, are disappointed so the make-a-wish spokesman and Cindy step outside where a doctor pushes by them in a rush. • The doctor and his intern enter an operation room but they are running so late the patient dies. • An employee enters to tell the doctor he was in such a rush that he left his car lights on and then heads down the hall where a female doctor is on break. The employee hits on the doctor who brushes him off with talk of her movie-loving boyfriend. • The doctor from earlier shows up and tells the employee to get back in the parking lot to check on more headlights, and then the doctor is ushered into an elevator to visit the morgue and take a look at patient zero. • The patient has had a dick drawn on his cheek and the doctor assumes its a side-effect of a disease and he decides to go call the government from the only working phone in the hospital. • He arrives there to be stuck in line behind a guy making personal calls. • Elle MacPherson walks…", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-the-mosaic", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=The_Mosaic", "create": true, "replacePlaceholder": true, "name": "The Mosaic", "category": "Long Form", "tags": "", "description": "=Structure= This is an intricate form, with smaller 'forms' performed within it during the course of the show. It requires a fairly large cast to do it justice.", "howToPlay": "This is an intricate form, with smaller 'forms' performed within it during the course of the show. It requires a fairly large cast to do it justice. =Shows/Classes= The Mosaic is currently taught in advanced classes at iO.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-the-movie", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=The_Movie", "create": true, "replacePlaceholder": true, "name": "The Movie", "category": "Long Form", "tags": "", "description": "Improvised movie: disjointed situations inspired by the suggestion that converge by the end.", "howToPlay": "• The cast asks the audience the name a lyric of their favorite song. Using the line as inspiration, the cast describes three scenes using the terminology of screenplay directions. They'd all take turns describing the scenes, taking over for each other in mid-sentence. • Here's an example of the first description in the opening, and the start of the second description. • Improviser 1: \"We open on tracking shot of students cramming in a library. They're college-aged, well-dressed. Piles of law books...\" • Improviser 2: \"... surround them. We settle on one student who unlike the rest is dressed in blue jeans and a t-shirt. He doesn't appear nervous at all, in fact he's asleep, with an empty notebook...\" • Improviser 3: \"We see his T-shirt is a novelty T-shirt that says 'I took the LSAT stoned.'\" • Improviser 2: \"We cut away from this scene to a luxurious townhouse. Inside is a posh bedroom where a stuffy-looking man is getting ready for bed.\" • As narrators describe each scene, players from the backline step in to become the characters as they are mentioned. There is no dialogue in the opening, the characters silently mime and move in the space under the narration. After three location scenes are set up, one improvisers steps forward and gives a title to indicate the opening is over. • Improviser: \"The camera pans to a university blue book, the title appears in red ink 'Crammin'…", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-the-pilot", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=The_Pilot", "create": true, "replacePlaceholder": true, "name": "The Pilot", "category": "Long Form", "tags": "", "description": "The Pilot also known as \"The Spin-off\" follows the structure of a sitcom or time-dash Harold and combined with a written narrative. Performers improvise within the narrative, and make discoveries that are honored throughout the piece.", "howToPlay": "Performers improvise within the narrative, and make discoveries that are honored throughout the piece.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-the-trip", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=The_Trip", "create": true, "replacePlaceholder": true, "name": "The Trip", "category": "Long Form", "tags": "", "description": "The Trip is a long form developed by Mission IMPROVable and Liz Allen. It has been performed at the Chicago Improv Festival and the Del Close Marathon. It is organic improv. A suggestion leads to a group group game. The \"form\" is a constant morphing of one organic game into the next, attempting to recognize patterns and call-back games. There was the occasional scene, but the key was that all of the performers (usually 5-7) were on-stage and involved the entire time, so a 2 person scene always featured the rest of the group portraying environment.", "howToPlay": "It is organic improv. A suggestion leads to a group group game. The \"form\" is a constant morphing of one organic game into the next, attempting to recognize patterns and call-back games. There was the occasional scene, but the key was that all of the performers (usually 5-7) were on-stage and involved the entire time, so a 2 person scene always featured the rest of the group portraying environment. It usually lasted 25-35 minutes, and would end with a performer stepping forward to get the suggestion again--the idea being that the show took place entirely inside the brain in the split second when the suggestion is yelled out. Discussed on the IRC Improvisation forum.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-the-exploding-dinosaur-pillow-fight", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=The_exploding_dinosaur_pillow_fight", "create": true, "replacePlaceholder": true, "name": "The exploding dinosaur pillow fight", "category": "Long Form", "tags": "", "description": "The Exploding Dinosaur Pillow Fight is a longform improvised form developed via collaboration between Lou Lasher and the team Mandudebro. The form has 2 sections. The first section is the Exploding Dinosaur part, made up of 3 medium length or longer scenes. The team asks for 2 suggestions along the lines of words of advice someone gave you, words to live by, compliments given or received, a song lyric, a line from a movie-- any 2 things along those lines. The first scene starts with those lines as the first 2 lines spoken in the scene. The second scene also starts with the same two lines of dialog, but said in different ways and then proceeds in its own way independent of the first scene.…", "howToPlay": "• It was born out of the effort to create a kind of Deconstruction that was well suited to a 4 person team and to fit the way Mandudebro plays. The form is easily adapted for teams of various sizes. It debuted April 20th, 2013, at Artsquest Center which is part of the Steel Stacks campus in Bethlehem, PA. • Several important improv principles are built into the structure of The Exploding Dinosaur Pillow Fight. For instance: • Less is more: rather than generate a lot of material to then find ways to use, the form starts organically with two scenes that essentially use the same starting point. The form then shows how that starting point can make for a lot of interesting differences in scenes that, together with the 3rd scene, also generate enough material for the whole set. • The end is in the beginning: the 3rd scene of the form shows the initiation as point in a relationship to be arrived at, not as starting point. • The two sections represent the 2 sides of the creative process: the discovery of many new ideas once the creative process is started is found in the Exploding Dinosaur section; and the convergence on the finished piece once the material is explored and what the piece is meant to be reveals itself to the players in the Pillow Fight section. The Convergent Scene ends as the transition to the Pillow Fight section.. • The element of Tempo is a big part of the form…", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-the-living-room", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=The_living_room", "create": true, "replacePlaceholder": true, "name": "The living room", "category": "Long Form", "tags": "", "description": "The Living Room is a form revolving around performers sitting in chairs (in a horseshoe) having a discussion. The discussions are based on the audience suggestion. Eventually someone breaks into the center of the horseshoe and initiates a scene. Anywhere from just one to many scenes could evolve. When a topic is played out, someone that is still in the chairs initiates the conversation again by verbally taking the focus. Organically a new strain of a topic emerges and then more scenes. This goes back and forth between conversation and scene work. One important thing to note is that conversations get less frequent and scenes get more frequent.", "howToPlay": "The Living Room was created at IO", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-theatrical-improv", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Theatrical_improv", "create": true, "replacePlaceholder": true, "name": "Theatrical improv", "category": "Long Form", "tags": "", "description": "Theatrical Improv, pioneered by Defiant Monkey Improv in 2009 is a an improv form focused primarily on the central concept of storytelling. Employing tactics of both longform and shortform, theatrical improv's main goal is to create a central storyline roughly following the structure of Campbell's Hero's Journey and Dan Harmon's stylized version of it, The Story Circle. Inspired by the works of Keith Johnstone, Viola Spolin, and Del Close, theatrical improv provides a comprehensive and flexible structure well suited to the demands of an improv performance.", "howToPlay": "Inspired by the works of Keith Johnstone, Viola Spolin, and Del Close, theatrical improv provides a comprehensive and flexible structure well suited to the demands of an improv performance.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-time-warp", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Time_Warp", "create": true, "replacePlaceholder": true, "name": "Time Warp", "category": "Warm-Up", "tags": "Warm-Up", "description": "Replay or jump the same beat at a different speed or era on a call.", "howToPlay": "• To hear (and read the musical notation of) the rhythm of this exercise, see here. (Hover your cursor above the the text that says \"All Together\" at the top of the piece to find a play button). • Everybody in a circle. • In unison, repeat the refrain: \"Musta been a time warp, time warp, musta been a time warp time warp time warp.\" • An improviser than has 4 bars to do or say whatever she pleases. This should be as free-spirited, free-associative, and free-formed as possible. • Then repeat the refrain. • Developed by the Mira Costa High School team in ComedySportz Los Angeles' High School League, sometime in the 2010-2011 school year. Jordan Johnson and Duncan Gregory deserve the most credit. Both Dangerbox, an ensemble at NYU, and the Ad-Libs, an ensemble at Skidmore College, have since made great use of Time Warp.", "gimmicks": "Emphasize that this exercise is about reckless abandon. Challenge people to truly have no idea what they're going to say.", "variations": "Some play this game cycling around the circle, meaning the person next to you goes after you have gone. This is an advanced structure for the game, as it allows improvisers to know when they are going to have to go, and therefore provides time to pre-plan. An advanced improviser will pass this opportunity up and follow their spontaneity, but a beginning one will not. For beginners, make this a pass the focus game. The initial improviser will point to a random person in the circle only moments…", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-tom-s-diner", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Tom%27s_Diner", "create": true, "replacePlaceholder": true, "name": "Tom's Diner", "category": "Warm-Up", "tags": "Warm-Up", "description": "Players take turns singing a short story or moment from their lives, following the rhythm and melody of the iconic “do do do-do” refrain. The group joins in for the chorus after each turn.", "howToPlay": "• Start by standing or sitting in a circle. • One person who knows the song sings it to \"Doo\" and then everyone joins to learn it. • do do do-do, do do do-do… • The first player shares their story in a short verse, using the same melody. • For example: • “Just this morning I woke u-up, • And I made myself some coffee. • I was tired, that was normal, • But thank-fully the coffee wo-rked!” • When their verse ends, the whole group sings the refrain together: • do do do-do, do do do-do… • Then, the next player takes their turn. Each player should sing a short, simple story. It could be anything: what they did that morning, something funny from their week, or even a random thought. • For example: • “I don’t kno-ow what I’m doing, • Singing this song sure is scary. • But I’m glad that I’m here doing-it, • And it’s actually kind of fu-un.” • After everyone has shared their verse, the game wraps up with one final group refrain: • do do do-do, do do do-do… • Keep your story simple and light. It doesn’t need to be perfect! • If you’re unsure what to sing about, just think of something small from your day or week. • Cheer each other on to make it fun and supportive!", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-town-council", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Town_Council", "create": true, "replacePlaceholder": true, "name": "Town Council", "category": "Long Form", "tags": "", "description": "== Town Council ==\n\nOrigin\nTown Council is a form developed by Bearded Men Improv and is based on a basic Harold. Needed\nThis form works well for mid to larger sized groups. -Two improvisers to take on the roles as leaders of the meeting (Two helps in keeping each other in check and helping move the meeting along). -Other improvisers act as town people.", "howToPlay": "• Origin • Town Council is a form developed by Bearded Men Improv and is based on a basic Harold. • Needed • This form works well for mid to larger sized groups. • Two improvisers to take on the roles as leaders of the meeting (Two helps in keeping each other in check and helping move the meeting along). • Other improvisers act as town people. • How it Works • The \"leaders\" make up a town name, call the meeting to order and get a few an audience suggested town problems. The other improvisers disperse into the audience to act as citizens. • From here, they all (leaders and improviser citizens) discuss the main issue and possible scenarios to solve it. After this brief discussion period, all improvisers participate in scenes based off the provided scenarios. The scenes may or may not be exactly like the scenarios, but should always be helping move the whole story forward. They can involve characters from the meeting or new ones. • After three or four scenes, we return to the town meeting, with the same people acting as the leaders, to quickly discuss how well the previous scenes helped the overall problem or didn’t and to suggest more. • This pattern continues until some type of resolution is come to, but most likely only three, maybe four times will it return to the meeting. The set can either end with the town meeting being adjourned or during a wrap up type scene. • First…", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-tracers", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Tracers", "create": true, "replacePlaceholder": true, "name": "Tracers", "category": "Long Form", "tags": "", "description": "A series of scenes all taking place at the same time in and around one location. This show ran from March 8th to May 31, 2000 at the Upright Citizens Brigade Theatre in New York. It followed up on Individually Wrapped which had a similar cast. Over there, around the corner, upstairs, in that passing car, something is happening. One slice of life, thirty different angles.", "howToPlay": "Over there, around the corner, upstairs, in that passing car, something is happening. One slice of life, thirty different angles. For example, off a suggestion of \"fish water\" the first scene is the back of a restaurant where two workers are gutting fish. A waiter walks through at one point and drops off a stack of dishes. A later scene might show the dining room of the restaurant where two customers are arguing, and at one point a waiter comes in a stacks up their plates and leaves -- the moment before of what we've seen in the first scene. Players remained backstage during the scenes. To edit a scene, and actor -- usually not in the current scene -- would step forward and face the audience and begin speaking while the actors from the previous scene cleared. Then the speaking actor would continue his speech as he settled into the new scene, and another actor would step out to reveal who he had been talking to.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-true-hollywood-stories", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=True_Hollywood_Stories", "create": true, "replacePlaceholder": true, "name": "True Hollywood Stories", "category": "Long Form", "tags": "", "description": "True Hollywood Stories is an improv form and show that ran at the UCB Theatre in New York in 2007. The show starts with an interview of a random audience member. The cast than explodes that persons life into the classic sensationalized rise and fall story common to The E True Hollywood Story or VH1's Behind The Music. This show was created by Steven Slate with the indispensable help of director Bobby Moynihan and the remaining members of improv group Big Tobacco.", "howToPlay": "• The basic celebrity tale as portrayed on television is one of humble beginnings, a meteoric rise to fame, and a tragic scandalous crash and burn. This is the basic form of the True Hollywood Story. The players get information from an audience member, then they follow this basic structure of doing scenes that take place during the \"humble beginnings\", \"rise to fame\", and \"tragic downfall\", of the audience members life. These three segments are broken up by \"commercial breaks\" which are essentially a chance to do a group game. There are a few devices such as talking heads, the narrator, and a more intensive use of lighting and sound that make the stage show feel like the tv show. • Here's the basic form: • Interview (3-5 minutes) • Talking heads/dramatic narration opening (1-2 minutes) • \"humble beginnings\" segment (5-7 minutes) • Commercial Break (1 minute) • \"Rise to fame\" segment (7 minutes) • Commercial Break (1 minute) • \"Tragic downfall\" segment (7 minutes) • Find a random audience member, the only requirement is that they're willing to talk about their life on stage- make sure they're aware of that before they take the stage. Keep the interview brief, too much information can lead you all over the place, there's just a few basic pieces of info you're looking for: • I. Get a basic picture of their childhood and family life. When something interesting comes up, explore…", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-try-hard", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Try-Hard", "create": true, "replacePlaceholder": true, "name": "Try-Hard", "category": "Long Form", "tags": "", "description": "The Try-Hard is a longform. The scene can be performed solo, or with a team of improvisers.", "howToPlay": "• The stage is split into 3 sections. The get should be something geared toward a public speaking event. • Example: \"Virtually everyone is afraid of public speaking, right? So what's a situation you have found yourself in that you had to speak publicly?\" • Explain to the audience how the stage is split up. • Center stage is where the public speaker performs the speech. i.e. - The external. • Stage Right is where the internal monologue of the public speaker happens. i.e. - The internal. • Stage Left is where the audience for the public speech exists. There may be one or more audience members in the scene. i.e. - The audience. • All stage positions should play straight out to the audience. • The scene should start Center Stage with the public speaker performing a speech. Stage Left and Stage Right react to what is said by Center Stage. • The external will just be the speech. However confident or bold that public speech needs to be. The presentation is the key of this element. • The internal will be the chaos happening in the speakers mind as they deliver their remarks. The emotions and feelings are the keys of this element. • The audience will react in ways that live in the distance between the external presentation, and the internal feelings of the speech.", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "irc-two-sandwiches", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Two_Sandwiches", "create": true, "replacePlaceholder": true, "name": "Two Sandwiches", "category": "Warm-Up", "tags": "Warm-Up", "description": "Two Sandwiches is a rhyming warmup game that is also known as Two Penises. The \"Two Sandwiches\" name was first applied in San Antonio, Texas, by the team Fight Club. Players stand in a circle. While doing an upper body dance, moving the hands slightly as if holding and shaking two sandwiches, the group chants in a melodic way, \"Two sandwiches, two sandwiches. What would you do with two sandwiches?\"", "howToPlay": "• Everyone: \"Two sandwiches, two sandwiches. What would you do with two sandwiches?\" • A: \"With this sandwich I'd meet a cop. With this sandwich I'd beat a mop.\" • Everyone: \"Two sandwiches, two sandwiches. What would you do with two sandwiches?\" • B: \"With this sandwich I'd go to school. With this sandwich I'd ride my mule.\" • Everyone: \"Two sandwiches, two sandwiches. What would you do with two sandwiches?\" • C: \"With this sandwich I'd count the money. With this sandwich I'd spin some honey.\" • And so on...", "source": "IRC Improv Wiki"}, {"tab": "Games", "id": "jam-zip-zap-zop", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Zip_Zap_Zop"}, {"tab": "Terms", "id": "irc-absurd-character", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Absurd_character", "create": true, "replacePlaceholder": true, "term": "Absurd character", "category": "Encyclopedia", "definition": "An absurd character (weirdo or crazy man) has an unusual point of view. They may embody a nonsensical philosophy, or otherwise have strange behavior. A voice of reason character may be present to point out how unusual the behavior seems. In a matching scene or group game, multiple characters may be absurd."}, {"tab": "Terms", "id": "irc-analogous-scene", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Analogous_Scene", "create": true, "replacePlaceholder": true, "term": "Analogous Scene", "category": "Encyclopedia", "definition": "An Analogous Scene is any second or third Beat of a scene that places the Game or general idea of a previous scene into an alternate time or place. Dialog, actions, and other game moves are recontextualized within the new setting. For example, a first scene may be about children in a schoolyard trading snacks. An analogous beat off of that idea may be construction workers trading lunches, or soliders on a battlefield trading C-rations."}, {"tab": "Terms", "id": "term-backline", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Backline"}, {"tab": "Terms", "id": "irc-base-reality", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Base_reality", "create": true, "replacePlaceholder": true, "term": "Base reality", "category": "Encyclopedia", "definition": "The ordinary who/what/where of a scene before the unusual thing arrives."}, {"tab": "Terms", "id": "term-beat", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Beat"}, {"tab": "Terms", "id": "irc-behavior", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Behavior", "create": true, "replacePlaceholder": true, "term": "Behavior", "category": "Encyclopedia", "definition": "Behavior describes the way a character physically shows their ideas, philosophy, or unusual beliefs."}, {"tab": "Terms", "id": "term-blackout", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Blackout_(concept)"}, {"tab": "Terms", "id": "term-blue", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Blue"}, {"tab": "Terms", "id": "irc-button", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Button", "create": true, "replacePlaceholder": true, "term": "Button", "category": "Editing Moves", "definition": "The small tag or blackout that ends a scene on the laugh or the game."}, {"tab": "Terms", "id": "irc-chaff", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Chaff", "create": true, "replacePlaceholder": true, "term": "Chaff", "category": "Encyclopedia", "definition": "Chaff is superfluous information in an opening that's not tied to a premise or half idea. Chaff is similar to a one-word suggestion, except generated by the improvisers. If a player mentions a location in an opening in passing, that location becomes chaff that might be used as a location or inspiration in the set. Chaff generally is useful although not necessary for providing base reality"}, {"tab": "Terms", "id": "irc-character", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Character", "create": true, "replacePlaceholder": true, "term": "Character", "category": "Encyclopedia", "definition": "Character in improv theater is fictional representation of an individual created by an actor including humans, animals, fairy tale creates, aliens, ghosts, gods, monsters, or other types. Family, lovers, spouse, professions, friends, strangers, animals, objects, and fantastic creatures all can be character types"}, {"tab": "Terms", "id": "term-conflict", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Conflict"}, {"tab": "Terms", "id": "irc-cragged", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Cragged", "create": true, "replacePlaceholder": true, "term": "Cragged", "category": "Encyclopedia", "definition": "When an improviser completely surprises his scene partner by delivering a line completely out of nowhere, and yet perfect for the scene. In the following example (from a Primal Bias show) Will Hines, the police chief, is reprimanding one his officers, played by Kevin Cragg who keeps letting people go from prison. Chief: \"I don't care what your reasons are, you have to stop letting everyone go free.\" Officer: (winces in shame) \"You're free to go\" (Cragged!) Chief: (starts to leave, then stops and glares at Cragg) \"I'm not in jail!\" Officer: (winces again) To Be Cragged was coined by Kevin Hines and inspired by Kevin Cragg's style of play in improv. After a scene in which Kevin Cragg cragged Will Hines for the first time Kevin Hines leaned over to Will and whispered \"You just got cragged\" Kevin Cragg cragged numerous members of Primal Bias, but the term became more popular when Kevin…"}, {"tab": "Terms", "id": "term-cut-to", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Cut-to"}, {"tab": "Terms", "id": "term-denial", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Denial"}, {"tab": "Terms", "id": "term-edit", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Edit"}, {"tab": "Terms", "id": "irc-endowment", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Endowment", "create": true, "replacePlaceholder": true, "term": "Endowment", "category": "Encyclopedia", "definition": "Endowment or gifting means to name your scene partner's physical actions, strong feelings or other qualities."}, {"tab": "Terms", "id": "irc-exploring", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Exploring", "create": true, "replacePlaceholder": true, "term": "Exploring", "category": "Encyclopedia", "definition": "Exploring in improv means to make moves that help to find the logic, philosophy or rationale behind an absurd character. The voice of reason may attempt to come up with a justification. Otherwise, the absurd character might have a consistent philosophy to describe their motivations. Exploration supports increasingly ridiculous specifics as they come up with one simple consistent point of view or reasoning. A character's game will explore a consistent philosophy throughout the scene and therefore won't have to find a new one as new specifics are developed. After resting the game, they would continue to find a new way to connect their original logic to new scenarios."}, {"tab": "Terms", "id": "irc-format", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Format", "create": true, "replacePlaceholder": true, "term": "Format", "category": "Encyclopedia", "definition": "A format or form is a structure or guideline for longer improvised scenes or series of scenes in longform improv. The Harold could be described a series of connected scenes along with improv games"}, {"tab": "Terms", "id": "term-framing", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Framing"}, {"tab": "Terms", "id": "term-game", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Game"}, {"tab": "Terms", "id": "irc-group-game", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Group_Game", "create": true, "replacePlaceholder": true, "term": "Group Game", "category": "Encyclopedia", "definition": "A group scene inside a Harold (or similar) that plays a game inspired by the opening, not a fourth plot."}, {"tab": "Terms", "id": "term-heightening", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Heightening"}, {"tab": "Terms", "id": "irc-if-then", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=If,_Then", "create": true, "replacePlaceholder": true, "term": "If, Then", "category": "Encyclopedia", "definition": "If This is True, Then What Else is True? (often shortened to If, Then) is an improvisational concept, mostly employed in longform improv, that helps improvisers build a pattern out of an unusual thing and thereby find a Game."}, {"tab": "Terms", "id": "term-initiation", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Initiation"}, {"tab": "Terms", "id": "irc-justification", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Justification", "create": true, "replacePlaceholder": true, "term": "Justification", "category": "Essentials", "definition": "Making a strange choice make sense in the world you already built."}, {"tab": "Terms", "id": "irc-macro-location", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Macro-location", "create": true, "replacePlaceholder": true, "term": "Macro-location", "category": "Encyclopedia", "definition": "A macro-location is larger setting that is comprised of many locations within it. Examples of a macro-location are: Hospital Shopping mall University campus Police station Main street of a small town Walmart Cruise ship Forms or exercises which use this concept will have all of their scenes confined to one macro-location. For instance, if you declared or discovered that your macro-location was a hospital, you might have scenes which take place in an operating room, a waiting room, a doctor's office, a lab, the cafeteria, etc. Characters may find themselves in multiple settings within the hospital. Often these exercises or forms are confined by a time frame too. For instance, all scenes take place on the same day, the same hour, or even the same 15 minutes. Examples of shows which use the concept of a macro-location would be Close Quarters, Tracers and of course, The Macroscene."}, {"tab": "Terms", "id": "irc-matching", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Matching", "create": true, "replacePlaceholder": true, "term": "Matching", "category": "Essentials", "definition": "Doing the same energy, activity, or point of view as your partner instead of opposing it."}, {"tab": "Terms", "id": "irc-meta", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Meta", "create": true, "replacePlaceholder": true, "term": "Meta", "category": "Encyclopedia", "definition": "Meta improv or commenting is a move/show that acknowledges itself as improv, the performers as improvisers, the audience watching the show, or otherwise recognizes the circumstances of the show – beyond the fictional characters, world, or scene."}, {"tab": "Terms", "id": "term-object-work", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Object_work"}, {"tab": "Terms", "id": "irc-offers", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Offers", "create": true, "replacePlaceholder": true, "term": "Offers", "category": "Essentials", "definition": "Anything you say or do that the scene can treat as real."}, {"tab": "Terms", "id": "term-opening", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Opening"}, {"tab": "Terms", "id": "irc-premise", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Premise", "create": true, "replacePlaceholder": true, "term": "Premise", "category": "Encyclopedia", "definition": "A tight comic idea — unusual thing plus who it happens to — that a scene can play."}, {"tab": "Terms", "id": "irc-relationship", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Relationship", "create": true, "replacePlaceholder": true, "term": "Relationship", "category": "Encyclopedia", "definition": "In improv, a relationship is the behavioral dynamic between characters. The relationship is not the back story behind the two characters knowing each other nor a label like \"son\" and \"dad\". For example, the details of a romantic relationship including whether they're dating, engaged or married are not what the scene is about. What matters is how they treat each other and how they make each other feel and react."}, {"tab": "Terms", "id": "irc-resolution", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Resolution", "create": true, "replacePlaceholder": true, "term": "Resolution", "category": "Encyclopedia", "definition": "Resolution is an element of scenework. It is a core component of the story structure String of Pearls, used more frequently in shortform improv than in longform improv. It refers to the solution that the characters devise to a previously-established conflict."}, {"tab": "Terms", "id": "irc-rest", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Rest", "create": true, "replacePlaceholder": true, "term": "Rest", "category": "Encyclopedia", "definition": "Rest is an improv concept where performers purposefully avoid the focus of the scene, a game, pattern, or running ideas. Resting allows for the tension in the scene to build as the audience wonders if the earlier ideas will return. In game-based improv, the term may be referred to as resting the game"}, {"tab": "Terms", "id": "irc-scene", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Scene", "create": true, "replacePlaceholder": true, "term": "Scene", "category": "Encyclopedia", "definition": "A scene is the place where a series of fictional events occur or occurred on stage. \"A scene is a sequence where a character or characters engage in some sort of action and/or dialogue. Scenes should have a beginning, middle and end (a mini-story arc), and should focus around a definite point of tension that moves the story forward.\" :Teach Yourself How to Write a Blockbuster, by Lee Weatherly and Helen Corner (pg 40, 2006 edition) \"By “scene” we mean here all that is included in an unbroken flow of action from one incident in time to another […] The action within a scene is ‘unbroken’ in the sense that it does not include a major time lapse or a leap from one setting to another – though the characters may, of course, walk or ride from one place to another without breaking the scene, the camera, so to speak, dollying after them.\" :The Art of Fiction: Notes on Craft for Young Writers…"}, {"tab": "Terms", "id": "irc-scene-partner", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Scene_partner", "create": true, "replacePlaceholder": true, "term": "Scene partner", "category": "Encyclopedia", "definition": "A scene partner is an improvisor in a scene of two or more people."}, {"tab": "Terms", "id": "irc-scene-work", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Scene_work", "create": true, "replacePlaceholder": true, "term": "Scene work", "category": "Encyclopedia", "definition": "Scene work refers to the stagecraft of starting improv scenes, creating characters, using real-life space work on stage, edits and wipes, tilts, and the way basic story structure is physically communicated on stage by performers."}, {"tab": "Terms", "id": "irc-showmanship", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Showmanship", "create": true, "replacePlaceholder": true, "term": "Showmanship", "category": "Encyclopedia", "definition": "Showmanship or stagecraft is any tool that helps demonstrate theatrical skill and professionalism in front of an audience. For many teams, poor showmanship might include a commitment to the fiction of the scene and breaking for laughter. Stagecraft tools include avoiding blind spots on stage, making sure that other performers are not obstructing view of your moves from the audience, and partially facing out toward the audience--known as cheating out. Performers are also encouraged in theater to stand at similar levels to help this, rather than upstage where they force a player to face away. If one performer moves front, another performer might want to would toward the front to avoid upstaging"}, {"tab": "Terms", "id": "term-sideline", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Sideline"}, {"tab": "Terms", "id": "term-space-work", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Space_work"}, {"tab": "Games", "id": "ie-split-screen", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Split-Screen"}, {"tab": "Terms", "id": "term-status", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Status"}, {"tab": "Terms", "id": "irc-steamrolling", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Steamrolling", "create": true, "replacePlaceholder": true, "term": "Steamrolling", "category": "Pitfalls", "definition": "Overriding your partner’s offers so the scene becomes a solo. Don’t."}, {"tab": "Terms", "id": "irc-string-of-pearls", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=String_of_Pearls", "create": true, "replacePlaceholder": true, "term": "String of Pearls", "category": "Encyclopedia", "definition": "Narrative drill: fill in the missing beats of a story between a beginning and an end."}, {"tab": "Terms", "id": "irc-suggestion", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Suggestion", "create": true, "replacePlaceholder": true, "term": "Suggestion", "category": "Encyclopedia", "definition": "The audience gift that starts a scene or set. Use it; don’t illustrate it for its own sake."}, {"tab": "Terms", "id": "term-sweep-edit", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Sweep_Edit"}, {"tab": "Terms", "id": "irc-swinging-door", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Swinging_Door", "create": true, "replacePlaceholder": true, "term": "Swinging Door", "category": "Encyclopedia", "definition": "A swinging door is a form of edit in which a third player will momentarily interrupt the scene by grabbing and spinning one of the players already in the scene, offering a brief initiation, and then swinging the player back into the scene. The original scene is put on pause as the swinging door is performed and returns in the same place when the swinging door player leaves the stage. The player performing the swinging door transports the first player to another time or place (usually the recent past, but this is not the only possibility). There, information is revealed that sheds new light on the current scene at hand or shows the comic results of a character's Game. A Swinging Door may also be used to ping-pong back and forth between two closely related situations. One very common use of the Swinging Door edit is to show the last pertinent piece of advice that a character received. A…"}, {"tab": "Terms", "id": "term-tag-out", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Tag-out"}, {"tab": "Terms", "id": "term-talking-heads", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Talking_heads"}, {"tab": "Terms", "id": "irc-teaching-scene", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Teaching_scene", "create": true, "replacePlaceholder": true, "term": "Teaching scene", "category": "Encyclopedia", "definition": "A teaching scene or puppet master scene is a scene where one character proceeds to teach, give commands, and give instructions. These are difficult as the scene partner will be challenging especially for new improvisers as one character is said to not have any information to add, while the other has to lead. The roles don't have to be literal teachers, as any scene where one character is right and another is wrong or needs help could inadvertently mimic the dynamic of a teacher scene. A successful character might be a teacher with other details outside of their job function. The successful student character can know how to do things."}, {"tab": "Terms", "id": "term-time-dash", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Time_dash"}, {"tab": "Terms", "id": "irc-top-of-intelligence", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Top_of_intelligence", "create": true, "replacePlaceholder": true, "term": "Top of intelligence", "category": "Encyclopedia", "definition": "Play the reality as smartly as you actually understand it. Don’t dummy down."}, {"tab": "Terms", "id": "term-transaction-scene", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Transaction_scene"}, {"tab": "Terms", "id": "irc-voice-of-reason", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Voice_of_reason", "create": true, "replacePlaceholder": true, "term": "Voice of reason", "category": "Encyclopedia", "definition": "The grounded player who treats the unusual thing as real and tries to live with it."}, {"tab": "Terms", "id": "irc-walk-on", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Walk-on", "create": true, "replacePlaceholder": true, "term": "Walk-on", "category": "Support Moves", "definition": "A brief extra character who enters, makes one strong offer, and leaves."}, {"tab": "Terms", "id": "term-warm-up", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Warm_up"}, {"tab": "Terms", "id": "irc-what", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=What", "create": true, "replacePlaceholder": true, "term": "What", "category": "Encyclopedia", "definition": "What you are doing. Play the activity, not a topic."}, {"tab": "Terms", "id": "irc-where", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Where", "create": true, "replacePlaceholder": true, "term": "Where", "category": "Encyclopedia", "definition": "Where you are. See it and use it."}, {"tab": "Terms", "id": "irc-who", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Who", "create": true, "replacePlaceholder": true, "term": "Who", "category": "Encyclopedia", "definition": "Who you are to each other. Name the relationship early."}, {"tab": "Terms", "id": "irc-world-dash", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=World_dash", "create": true, "replacePlaceholder": true, "term": "World dash", "category": "Encyclopedia", "definition": "A world dash explores another part of the same universe that was set up in the first scene. This is similar to a time dash yet doesn’t follow any previously seen characters. For example, a second or third beat scene showing two new characters who are implied to work in a different part of the same company, seeing the parents or teachers of children in an earlier scene, or otherwise establishing that new characters exist in the same world as an earlier scene"}, {"tab": "Terms", "id": "irc-world-game", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=World_game", "create": true, "replacePlaceholder": true, "term": "World game", "category": "Encyclopedia", "definition": "A world game is when the game of the scene seems to be embodied in the elements and structure of the greater or physical world. This tells the audience that the unusual point of view is matched by many characters in that world. The effect of a world game is to make the voice of reason seem like they are the unreasonable character. The world game asks: If the unusual philosophy and behavior of an unusual character is shared by others in that world, what else is true?"}, {"tab": "Terms", "id": "term-yes-and", "sourceIds": "src-irc-wiki", "sourceUrl": "https://wiki.improvresourcecenter.com/index.php?title=Yes_And"}, {"tab": "Games", "id": "ie-double-opening", "category": "Opening", "tags": "Opening"}];
