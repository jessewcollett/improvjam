var LEARN_IMPROV_SOURCE = {"id": "src-learnimprov", "name": "Learn Improv", "url": "https://www.learnimprov.com/", "note": "CC BY-SA 4.0. https://www.learnimprov.com/about/legal/"};
var LEARN_IMPROV_PATCHES = [{"id": "jam-entrances-exits", "name": "Entrances and Exits", "sourceIds": "src-jam-terms|src-learnimprov", "sourceUrl": "https://www.learnimprov.com/entrances-and-exits-2/", "synonyms": "Exits|Word Game|Walkout|Entrances / Exits", "description": "Each player gets a secret word. Hear yours: enter if you are offstage, or leave if you are on. Justify the move in the story — do not just run on and off.", "setup": "Host gives every possible player a different word (mix nouns, verbs, adjectives). Start with one person on stage.", "howToPlay": "You cannot say your own word to trigger yourself. When you enter or exit, give a reason that fits the scene. Keep the narrative; the words are a complication, not the whole game.", "gimmicks": "Give someone a tiny common word (and, the). Repeat a word to bounce them on and off. Beg them to leave without saying their word.", "variations": "Emotional entrance (Jam): skip the secret word and enter already mad, sad, glad, or afraid."}, {"id": "ie-switch-gibberish", "name": "Gibberish Switch", "sourceIds": "src-encyclopedia|src-learnimprov", "sourceUrl": "https://www.learnimprov.com/gibberish-switch-handle/", "synonyms": "Switch Gibberish|Accents", "description": "On a clap or bell, switch between English and gibberish without pausing or dropping the story. Do not mock real languages or cultures.", "setup": "Pairs for the drill, or an open scene for the handle. Leader holds the switch cue.", "howToPlay": "Talk through the switch. The story should still make sense. Leader can switch everyone at once or only one player.", "gimmicks": "Leave one player in gibberish. Use two different gibberish sounds. Amoeba / tree / worm gibberish.", "variations": "Exercise: pairs, practice sounding different (Learn Improv). Handle: play it as a scene. Encyclopedia: tell a story and switch whenever the bell rings."}, {"id": "jam-conducted-story", "name": "Conducted Story", "sourceIds": "src-jam-terms|src-learnimprov", "sourceUrl": "https://www.learnimprov.com/conducted-story-die/", "synonyms": "Story Story Die|Die Game|Conducted Story-Die", "description": "Players in a line tell one story. Whoever the conductor points at keeps talking. When the point moves, the next person picks up mid-sentence or even mid-word.", "setup": "Four or five players in a line. Conductor faces them.", "howToPlay": "Handoffs should sound like one voice. Point longer or shorter to change the pressure.", "gimmicks": "Hold one player for a long time. Jump quickly player to player.", "variations": "Die: hesitate or miss a handoff and you are out (Learn Improv competitive version). Gibberish story. Conductor stands behind and taps backs. Word at a time."}, {"id": "ie-pass-ball", "name": "Pass Ball", "sourceIds": "src-encyclopedia|src-learnimprov", "sourceUrl": "https://www.learnimprov.com/ball-pass/", "synonyms": "Ball Pass", "description": "Circle. Mime a ball with a real size, weight, and shape. Catch exactly what was thrown; then the leader can change it.", "setup": "Circle, facing in. One mime ball to start.", "howToPlay": "Match the ball you receive. Leader may make it heavier, lighter, huge, tiny, smelly, sad, or joyful.", "gimmicks": "Add a second ball going the other way.", "variations": "Clay: pass a mouldable blob instead of a ball."}, {"id": "ie-open-your-hand", "name": "Open Your Hands", "sourceIds": "src-encyclopedia|src-learnimprov", "sourceUrl": "https://www.learnimprov.com/open-your-hands/", "synonyms": "Open Your Hand|Pennies From Heaven", "description": "Walk the room. On the call, open your hands and catch something falling from the sky. Name it, set it aside, keep walking. There are no wrong answers.", "setup": "Players mill about. Keith Johnstone’s Pennies From Heaven.", "howToPlay": "Catch, name, discard, repeat. Leader can change what falls (heavy, sticky, cuddly) or make an object that needs two people to catch — agree in mime.", "gimmicks": "Catch something abstract (democracy, an abyss).", "variations": "Encyclopedia and Learn Improv are the same game; the name is singular or plural."}, {"id": "ie-tug-o-war", "name": "Tug of War", "sourceIds": "src-encyclopedia|src-learnimprov", "sourceUrl": "https://www.learnimprov.com/tug-of-war/", "synonyms": "Tug-O-War", "description": "Two lines mime one rope. Nobody has to win. If they pull, you give. Sell the rope together so it does not stretch or snap by accident.", "setup": "Two lines facing each other.", "howToPlay": "Match the other side’s effort. Leader can endow who is winning or who gets sleepy. Encyclopedia notes one group can gladly lose (chivalry).", "gimmicks": "The rope breaks. Move people so the sides are lopsided.", "variations": "Competitive tug (someone wins) vs ensemble tug (the rope is the point)."}, {"id": "jam-stunt-double", "name": "Stunt Doubles", "sourceIds": "src-jam-terms|src-encyclopedia|src-learnimprov", "sourceUrl": "https://www.learnimprov.com/stunt-doubles/", "synonyms": "Stunt Double", "description": "An open scene. Host calls “Stunt Doubles”: a second pair tags in, copies the pose, and does the “dangerous” bit bigger. “First team” tags back and justifies the new pose.", "setup": "Two scene players on, two doubles off.", "howToPlay": "Start small, get zanier. Doubles usually do not talk; they may scream. Call it for ordinary things (opening a fridge).", "gimmicks": "Stunt everything, even walking. Leave the first team in when something is actually dangerous. Doubles get more injured each time.", "variations": "Slow motion stunts (Learn Improv). Jam short-form: only call a double for skilled or dangerous tasks."}, {"id": "jam-yes-yes-and", "name": "Yes And", "sourceIds": "src-jam-terms|src-encyclopedia|src-learnimprov", "sourceUrl": "https://www.learnimprov.com/yes-and/", "synonyms": "Yes / Yes And|Yes, And", "description": "Partner drill. First person makes a statement (not a question). Second says “Yes and…” and adds a little. Then keep going.", "setup": "Two players side by side.", "howToPlay": "Two flavors: Yes And (add right away) and Yes … And (agree first, then add). Do not block. Keep expanding the same offer.", "gimmicks": "", "variations": "Once the pattern is easy, stand up and play it as a short scene."}, {"id": "ie-mirror", "name": "Mirror", "sourceIds": "src-encyclopedia|src-learnimprov", "sourceUrl": "https://www.learnimprov.com/mirrors/", "synonyms": "Mirrors", "description": "Pairs, similar height. Copy each other’s movement like a mirror. Share the lead — no one should stay the leader.", "setup": "Pairs facing each other. Start slow (arms, face, then whole body).", "howToPlay": "Leader may assign who leads, then let them mix. Support your partner; do not try to trick them.", "gimmicks": "", "variations": "Distorting carnival mirror. A group mirrors an ongoing scene."}];
