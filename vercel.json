{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/catalog.js": {
      "maxDuration": 30
    },
    "api/media.js": {
      "maxDuration": 30
    },
    "api/share.js": {
      "maxDuration": 10
    },
    "api/stage.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
